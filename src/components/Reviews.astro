---
import type { SiteBundle } from "../data/site";
import SectionHeading from "./SectionHeading.astro";

type Props = {
  site: SiteBundle;
};

const { site } = Astro.props;
const { reviews, reviewsContent, sectionIds, ui, meta } = site;
const starIndexes = [0, 1, 2, 3, 4] as const;
---

<section
  id={sectionIds.reviews}
  class="mx-auto w-[min(1120px,calc(100%-2rem))] overflow-visible pt-[clamp(3rem,8vh,6rem)] pb-[clamp(4rem,10vh,7.5rem)] md:px-6 lg:px-8"
>
  <SectionHeading title={reviewsContent.heading} description={reviewsContent.description} />

  <div class="site-carousel mt-2" id="reviewsCarousel">
    <div class="site-carousel__viewport">
      <ul
        class="site-carousel__track"
        id="reviewsCarouselTrack"
        aria-label={ui.reviewsAria}
      >
        {
          reviews.map((review) => (
            <li class="site-carousel__slide">
              <article class="review-carousel-card">
                <div class="flex items-center gap-1" aria-hidden="true">
                  {starIndexes.map(() => (
                    <i class="fa-solid fa-star text-amber-400" />
                  ))}
                </div>
                <span class="sr-only">{ui.reviewStarsSr}</span>
                <blockquote class="review-carousel-card__quote">
                  “{review.quote}”
                </blockquote>
                <footer class="review-carousel-card__footer">
                  <p class="review-carousel-card__name">{review.name}</p>
                  <p class="review-carousel-card__treatment">{review.treatmentName}</p>
                </footer>
              </article>
            </li>
          ))
        }
      </ul>

      <button
        type="button"
        class="site-carousel__nav site-carousel__nav--prev"
        id="reviewsCarouselPrev"
        aria-controls="reviewsCarouselTrack"
        aria-label={ui.prevReview}
      >
        <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
      </button>
      <button
        type="button"
        class="site-carousel__nav site-carousel__nav--next"
        id="reviewsCarouselNext"
        aria-controls="reviewsCarouselTrack"
        aria-label={ui.nextReview}
      >
        <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
      </button>
    </div>
  </div>

  <p class="mt-8 mb-0 text-center">
    <a
      class="inline-flex items-center gap-2 font-medium text-brand-sage underline-offset-2 transition-opacity hover:opacity-80 hover:underline focus-visible:underline dark:text-brand-sage-bright"
      href={meta.googleReviewsUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      {reviewsContent.googleCta}
      <i class="fa-brands fa-google" aria-hidden="true"></i>
    </a>
  </p>
</section>

<script>
  import { initHorizontalCarousel } from "../scripts/horizontal-carousel";

  const track = document.getElementById("reviewsCarouselTrack") as HTMLElement | null;
  const prevBtn = document.getElementById("reviewsCarouselPrev") as HTMLButtonElement | null;
  const nextBtn = document.getElementById("reviewsCarouselNext") as HTMLButtonElement | null;

  if (track) {
    initHorizontalCarousel({
      track,
      prevBtn,
      nextBtn,
      slideSelector: ".site-carousel__slide",
      infinite: true,
    });
  }
</script>
