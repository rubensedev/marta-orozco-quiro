---
import { Image } from "astro:assets";
import { treatments, massagesContent } from "../data/site";
import type { ImageMetadata } from "astro";
import SectionHeading from "./SectionHeading.astro";

import relajanteImg from "../assets/images/relajante.webp";
import detoxImg from "../assets/images/detox.webp";
import descontracturanteImg from "../assets/images/descontracturante.webp";
import craneofacialImg from "../assets/images/craneofacial.webp";

const imageMap: Record<string, ImageMetadata> = {
  relajante: relajanteImg,
  detox: detoxImg,
  descontracturante: descontracturanteImg,
  "craneo-facial": craneofacialImg,
};

const first = treatments[0];
const firstImage = imageMap[first.id];
---

<section
  id="masajes"
  class="mx-auto w-[min(1120px,calc(100%-2rem))] overflow-visible py-[clamp(3rem,8vh,6rem)] md:px-6 lg:px-8"
>
  <SectionHeading
    title={massagesContent.heading}
    description={massagesContent.description}
  />

  <!-- Main panel: content card left, floating image right (side-by-side from tablet) -->
  <article
    id="massageMainPanel"
    class="massage-main-panel massage-card-reveal flex flex-col gap-8 md:flex-row md:items-center md:gap-8 lg:gap-10"
    data-pricing-card={first.id}
    data-treatment={first.bookingValue}
  >
    <div
      class="massage-main-panel__content min-w-0 rounded-[1.75rem] p-6 shadow-soft sm:p-7 md:min-w-0 md:flex-1 lg:p-8"
    >
      <h3
        id="panelTitle"
        class="m-0 wrap-break-word font-serif text-[clamp(1.35rem,2.8vw,2rem)] font-normal tracking-[0.04em] uppercase"
      >
        {first.title}
      </h3>
      <div
        class="mt-3"
        data-pricing-display
        aria-live="polite"
        aria-atomic="true"
      >
      </div>
      <p
        id="panelDescription"
        class="mt-3 mb-0 text-[0.95rem] leading-[1.55] text-brand-muted"
      >
        {first.description}
      </p>
      <div class="mt-5" data-pricing-mount></div>
      <button
        id="panelBookingBtn"
        class="btn-brand mt-5 w-full uppercase tracking-[0.08em] sm:w-auto"
        type="button"
        data-open-booking
        data-treatment={first.bookingValue}
      >
        Reservar {first.title}
      </button>
    </div>

    <div
      class="massage-main-panel__image relative mx-auto w-full max-w-sm min-w-0"
      id="panelImageWrapper"
    >
      <Image
        id="panelImage"
        src={firstImage}
        alt={first.imageAlt}
        width={720}
        height={900}
        class="aspect-4/5 h-full w-full rounded-[1.75rem] object-cover"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </article>

  <!-- Horizontal carousel -->
  <div class="massage-carousel mt-10" id="massageCarousel">
    <div class="massage-carousel__viewport">
      <ul
        class="massage-carousel__track"
        id="massageCarouselTrack"
        tabindex="0"
        role="listbox"
        aria-label="Tipos de masaje"
        aria-activedescendant={`massage-card-${first.id}`}
      >
        {
          treatments.map((treatment, i) => {
            const img = imageMap[treatment.id];
            const basePrice = treatment.durations[0].price;
            const selected = i === 0;
            return (
              <li class="massage-carousel__slide" role="presentation">
                <button
                  type="button"
                  id={`massage-card-${treatment.id}`}
                  role="option"
                  class:list={[
                    "massage-carousel-card massage-card-reveal",
                    selected ? "is-selected" : "",
                  ]}
                  data-carousel-card={treatment.id}
                  data-treatment-index={i}
                  data-image-alt={treatment.imageAlt}
                  aria-selected={selected ? "true" : "false"}
                >
                  <div class="massage-carousel-card__media" aria-hidden="true">
                    <Image
                      src={img}
                      alt=""
                      width={480}
                      height={640}
                      densities={[1, 2]}
                      class="massage-carousel-card__image"
                      loading="lazy"
                    />
                  </div>
                  <div class="massage-carousel-card__body">
                    <h3 class="massage-carousel-card__title">
                      {treatment.title}
                    </h3>
                    <p class="massage-carousel-card__desc">
                      {treatment.description}
                    </p>
                    <div class="massage-carousel-card__footer">
                      <span class="massage-carousel-card__price">
                        desde {basePrice}€
                      </span>
                      <span
                        class="massage-carousel-card__cta"
                        aria-hidden="true"
                      >
                        <i class="fa-solid fa-arrow-right"></i>
                      </span>
                    </div>
                  </div>
                </button>
              </li>
            );
          })
        }
      </ul>

      <button
        type="button"
        class="massage-carousel__nav massage-carousel__nav--prev"
        id="massageCarouselPrev"
        aria-controls="massageCarouselTrack"
        aria-label="Masaje anterior"
      >
        <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
      </button>
      <button
        type="button"
        class="massage-carousel__nav massage-carousel__nav--next"
        id="massageCarouselNext"
        aria-controls="massageCarouselTrack"
        aria-label="Masaje siguiente"
      >
        <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
      </button>
    </div>
  </div>
</section>

<script>
  import { initHorizontalCarousel } from "../scripts/horizontal-carousel";

  const panel = document.getElementById(
    "massageMainPanel",
  ) as HTMLElement | null;
  const track = document.getElementById(
    "massageCarouselTrack",
  ) as HTMLElement | null;
  const prevBtn = document.getElementById(
    "massageCarouselPrev",
  ) as HTMLButtonElement | null;
  const nextBtn = document.getElementById(
    "massageCarouselNext",
  ) as HTMLButtonElement | null;
  const panelTitle = document.getElementById(
    "panelTitle",
  ) as HTMLElement | null;
  const panelDesc = document.getElementById(
    "panelDescription",
  ) as HTMLElement | null;
  const panelImg = document.getElementById(
    "panelImage",
  ) as HTMLImageElement | null;
  const panelBookingBtn = document.getElementById(
    "panelBookingBtn",
  ) as HTMLButtonElement | null;

  const cards = Array.from(
    track?.querySelectorAll<HTMLButtonElement>("[data-carousel-card]") ?? [],
  );
  const treatmentIds = cards.map((c) => c.dataset.carouselCard!);

  const imgSrcMap: Record<string, string> = {};
  const imgAltMap: Record<string, string> = {};
  cards.forEach((card) => {
    const id = card.dataset.carouselCard!;
    const img = card.querySelector("img");
    if (img) {
      imgSrcMap[id] = img.currentSrc || img.src;
    }
    imgAltMap[id] = card.dataset.imageAlt ?? "";
  });

  let activeIndex = 0;
  let switching = false;
  const prefersReduced = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;
  const supportsViewTransition =
    typeof document.startViewTransition === "function";

  const carousel =
    track != null
      ? initHorizontalCarousel({
          track,
          prevBtn,
          nextBtn,
          slideSelector: ".massage-carousel__slide",
          infinite: false,
        })
      : null;

  function wait(ms: number) {
    return new Promise<void>((resolve) => {
      window.setTimeout(resolve, ms);
    });
  }

  function applyTreatment(id: string, treatment: any) {
    if (!panel) return;

    panel.dataset.pricingCard = id;
    panel.dataset.treatment = treatment.bookingValue;
    delete panel.dataset.selectedDuration;
    delete panel.dataset.selectedBono;

    if (panelTitle) panelTitle.textContent = treatment.title;
    if (panelDesc) panelDesc.textContent = treatment.description;
    if (panelBookingBtn) {
      panelBookingBtn.dataset.treatment = treatment.bookingValue;
      panelBookingBtn.textContent = `Reservar ${treatment.title}`;
    }
    if (panelImg && imgSrcMap[id]) {
      panelImg.src = imgSrcMap[id];
      panelImg.alt = imgAltMap[id] ?? treatment.imageAlt ?? "";
    }

    const w = window as any;
    if (typeof w.renderPricingWidgets === "function") {
      w.renderPricingWidgets();
    }
  }

  async function awaitImageReady() {
    if (!panelImg?.decode) return;
    try {
      await panelImg.decode();
    } catch {
      /* cached / decode failures are fine */
    }
  }

  async function swapWithFallback(update: () => void | Promise<void>) {
    if (!panel || prefersReduced) {
      await update();
      return;
    }

    panel.dataset.swap = "leaving";
    await wait(420);
    await update();
    panel.dataset.swap = "prep";
    void panel.offsetWidth;
    panel.dataset.swap = "entering";
    await wait(860);
    delete panel.dataset.swap;
  }

  async function swapPanel(update: () => void | Promise<void>) {
    if (prefersReduced || !supportsViewTransition) {
      await swapWithFallback(update);
      return;
    }

    const transition = document.startViewTransition(async () => {
      await update();
      await awaitImageReady();
    });

    try {
      await transition.finished;
    } catch {
      /* aborted / skipped */
    }
  }

  function getSlide(card: HTMLElement) {
    return (
      (card.closest(".massage-carousel__slide") as HTMLElement | null) ?? card
    );
  }

  function scrollCardIntoView(index: number) {
    const active = cards[index];
    if (!active || !track) return;
    const slide = getSlide(active);
    const padLeft = parseFloat(getComputedStyle(track).paddingLeft) || 0;
    const trackRect = track.getBoundingClientRect();
    const slideRect = slide.getBoundingClientRect();
    // Align card start to the prev-arrow midpoint (track inline padding).
    const left =
      track.scrollLeft + (slideRect.left - trackRect.left) - padLeft;
    track.scrollTo({
      left: Math.max(0, left),
      behavior: prefersReduced ? "auto" : "smooth",
    });
  }

  function scrollPanelIntoView() {
    if (!panel) return;
    const header = document.querySelector("header");
    const offset = (header?.getBoundingClientRect().height ?? 0) + 16;
    const top =
      window.scrollY + panel.getBoundingClientRect().top - offset;
    window.scrollTo({
      top: Math.max(0, top),
      behavior: prefersReduced ? "auto" : "smooth",
    });
  }

  function setActiveCard(index: number, { scroll = true } = {}) {
    if (index < 0 || index >= cards.length) return;
    activeIndex = index;
    cards.forEach((card, i) => {
      const on = i === index;
      card.classList.toggle("is-selected", on);
      card.setAttribute("aria-selected", String(on));
    });
    const active = cards[index];
    if (active && track) {
      track.setAttribute("aria-activedescendant", active.id);
    }
    if (scroll) scrollCardIntoView(index);
    carousel?.updateNavButtons();
  }

  async function switchTreatment(id: string) {
    if (!panel || switching) return;
    const w = window as any;
    const list: any[] = w.treatments ?? [];
    const treatment = list.find((t: any) => t.id === id);
    if (!treatment) return;

    const nextIndex = treatmentIds.indexOf(id);
    if (nextIndex < 0) return;

    if (nextIndex === activeIndex && panel.dataset.pricingCard === id) {
      setActiveCard(nextIndex);
      scrollPanelIntoView();
      return;
    }

    setActiveCard(nextIndex);
    scrollPanelIntoView();

    switching = true;
    try {
      await swapPanel(async () => {
        applyTreatment(id, treatment);
        await awaitImageReady();
      });
    } finally {
      switching = false;
    }
  }

  cards.forEach((card) => {
    card.addEventListener("click", (e) => {
      if (carousel?.consumeDragMoved()) {
        e.preventDefault();
        e.stopPropagation();
        return;
      }
      switchTreatment(card.dataset.carouselCard!);
    });
  });

  // Keyboard: left/right on focused track
  track?.addEventListener("keydown", (e) => {
    if (e.key === "ArrowRight") {
      e.preventDefault();
      const next = Math.min(activeIndex + 1, cards.length - 1);
      switchTreatment(treatmentIds[next]);
    } else if (e.key === "ArrowLeft") {
      e.preventDefault();
      const prev = Math.max(activeIndex - 1, 0);
      switchTreatment(treatmentIds[prev]);
    } else if (e.key === "Home") {
      e.preventDefault();
      switchTreatment(treatmentIds[0]);
    } else if (e.key === "End") {
      e.preventDefault();
      switchTreatment(treatmentIds[treatmentIds.length - 1]);
    }
  });

  const revealEls = document.querySelectorAll<HTMLElement>(
    ".massage-card-reveal",
  );
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          (entry.target as HTMLElement).classList.add("massage-card-visible");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12 },
  );
  revealEls.forEach((el, i) => {
    el.style.transitionDelay = `${i * 80}ms`;
    observer.observe(el);
  });

  setActiveCard(0, { scroll: false });
</script>
