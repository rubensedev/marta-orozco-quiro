---
import { Image } from "astro:assets";
import { treatments, massagesContent } from "../data/site";
import type { ImageMetadata } from "astro";

import relajanteImg from "../assets/images/relajante.webp";
import detoxImg from "../assets/images/detox.webp";
import descontracturanteImg from "../assets/images/descontracturante.webp";
import craneofacialImg from "../assets/images/craneofacial.webp";

const imageMap: Record<string, ImageMetadata> = {
  relajante: relajanteImg,
  detox: detoxImg,
  descontracturante: descontracturanteImg,
  "craneo-facial": craneofacialImg,
};

const first = treatments[0];
const firstImage = imageMap[first.id];
---

<section id="masajes" class="mx-auto w-[min(1120px,calc(100%-2rem))] py-24">
  <div class="mb-12 max-w-3xl">
    <h2 class="m-0 font-serif text-[clamp(2.25rem,4vw,3.5rem)] leading-[1.1] font-light">
      {massagesContent.heading}
    </h2>
    <p class="mt-4 mb-0 text-lg leading-[1.8] text-brand-muted">
      {massagesContent.description}
    </p>
  </div>

  <!-- Carousel grid -->
  <div
    class="mb-12 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4"
    id="massageCarousel"
  >
    {
      treatments.map((treatment, i) => {
        const img = imageMap[treatment.id];
        const basePrice = treatment.durations[0].price;
        return (
          <button
            type="button"
            class:list={[
              "massage-carousel-card group relative flex cursor-pointer flex-col overflow-hidden rounded-2xl bg-white/60 text-left shadow-soft transition duration-300 ease-out hover:-translate-y-1 hover:shadow-xl dark:bg-brand-card-dark/84 massage-card-reveal",
              i === 0 ? "ring-2 ring-brand-sage" : "",
            ]}
            data-carousel-card={treatment.id}
            data-treatment-id={treatment.id}
            aria-pressed={i === 0 ? "true" : "false"}
          >
            <div class="overflow-hidden rounded-t-2xl">
              <Image
                src={img}
                alt={treatment.imageAlt}
                width={400}
                height={280}
                class="aspect-[16/11] w-full object-cover transition duration-300 ease-out group-hover:scale-[1.08] group-hover:-translate-y-2"
                loading="lazy"
              />
            </div>
            <div class="flex flex-1 flex-col p-4">
              <h3 class="m-0 font-serif text-lg font-light tracking-[0.06em] uppercase">
                {treatment.title}
              </h3>
              <p class="mt-2 mb-0 line-clamp-2 text-sm leading-relaxed text-brand-muted">
                {treatment.description}
              </p>
              <div class="mt-auto flex items-center justify-between pt-3">
                <span class="text-sm font-semibold text-brand-sage">
                  desde {basePrice} €
                </span>
                <span class="text-xs text-brand-muted transition group-hover:text-brand-sage">
                  Ver opciones →
                </span>
              </div>
            </div>
          </button>
        );
      })
    }
  </div>

  <!-- Main panel -->
  <article
    id="massageMainPanel"
    class="massage-main-panel massage-card-reveal flex flex-col overflow-hidden rounded-[2rem] bg-white/60 shadow-soft dark:bg-brand-card-dark/84 lg:flex-row"
    data-pricing-card={first.id}
    data-treatment={first.bookingValue}
  >
    <!-- Left: content -->
    <div class="min-w-0 p-8 lg:flex-1 lg:p-12">
      <h3
        id="panelTitle"
        class="m-0 font-serif text-[clamp(2rem,4vw,3rem)] font-light tracking-[0.06em] uppercase"
      >
        {first.title}
      </h3>
      <div class="mt-6" data-pricing-display aria-live="polite" aria-atomic="true"></div>
      <p id="panelDescription" class="mt-5 mb-0 leading-[1.8] text-brand-muted">
        {first.description}
      </p>
      <div class="mt-8" data-pricing-mount></div>
      <button
        id="panelBookingBtn"
        class="btn-brand mt-8"
        type="button"
        data-open-booking
        data-treatment={first.bookingValue}
      >
        Reservar {first.title}
      </button>
    </div>

    <!-- Right: image -->
    <div class="relative min-w-0 lg:w-[46%] lg:shrink-0" id="panelImageWrapper">
      <Image
        id="panelImage"
        src={firstImage}
        alt={first.imageAlt}
        width={720}
        height={900}
        class="aspect-[4/5] h-full w-full object-cover lg:rounded-r-[2rem]"
        loading="eager"
      />
    </div>
  </article>
</section>

<script>
  const panel = document.getElementById("massageMainPanel") as HTMLElement | null;
  const carousel = document.getElementById("massageCarousel") as HTMLElement | null;
  const panelTitle = document.getElementById("panelTitle") as HTMLElement | null;
  const panelDesc = document.getElementById("panelDescription") as HTMLElement | null;
  const panelImg = document.getElementById("panelImage") as HTMLImageElement | null;
  const panelBookingBtn = document.getElementById("panelBookingBtn") as HTMLButtonElement | null;

  // Build img src map from rendered carousel thumbnails (Astro-optimized at build time)
  const imgSrcMap: Record<string, string> = {};
  const imgAltMap: Record<string, string> = {};
  carousel?.querySelectorAll<HTMLButtonElement>("[data-carousel-card]").forEach((card) => {
    const id = card.dataset.carouselCard!;
    const img = card.querySelector("img");
    if (img) {
      imgSrcMap[id] = img.src;
      imgAltMap[id] = img.alt;
    }
  });

  function switchTreatment(id: string) {
    if (!panel) return;
    const w = window as any;
    const treatments: any[] = w.treatments ?? [];
    const treatment = treatments.find((t: any) => t.id === id);
    if (!treatment) return;

    panel.style.transition = "none";
    panel.style.opacity = "0";
    panel.style.transform = "translateY(8px)";

    setTimeout(() => {
      panel.dataset.pricingCard = id;
      panel.dataset.treatment = treatment.bookingValue;
      delete panel.dataset.selectedDuration;
      delete panel.dataset.selectedBono;

      if (panelTitle) panelTitle.textContent = treatment.title;
      if (panelDesc) panelDesc.textContent = treatment.description;
      if (panelBookingBtn) {
        panelBookingBtn.dataset.treatment = treatment.bookingValue;
        panelBookingBtn.textContent = `Reservar ${treatment.title}`;
      }
      if (panelImg && imgSrcMap[id]) {
        panelImg.src = imgSrcMap[id];
        panelImg.alt = imgAltMap[id] ?? "";
      }

      if (typeof w.renderPricingWidgets === "function") w.renderPricingWidgets();

      panel.style.transition = "opacity 0.3s ease, transform 0.3s ease";
      panel.style.opacity = "1";
      panel.style.transform = "translateY(0)";
    }, 180);
  }

  // The panel booking button click is handled by PageScripts' delegated listener on [data-open-booking].
  // After treatment switch, PageScripts re-reads data-treatment from the button so no extra wiring needed.

  carousel?.querySelectorAll<HTMLButtonElement>("[data-carousel-card]").forEach((card) => {
    card.addEventListener("click", () => {
      const id = card.dataset.carouselCard!;
      carousel.querySelectorAll<HTMLButtonElement>("[data-carousel-card]").forEach((c) => {
        c.classList.remove("ring-2", "ring-brand-sage");
        c.setAttribute("aria-pressed", "false");
      });
      card.classList.add("ring-2", "ring-brand-sage");
      card.setAttribute("aria-pressed", "true");
      switchTreatment(id);
      panel?.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  });

  // Scroll-reveal
  const revealEls = document.querySelectorAll<HTMLElement>(".massage-card-reveal");
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          (entry.target as HTMLElement).classList.add("massage-card-visible");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12 },
  );
  revealEls.forEach((el, i) => {
    el.style.transitionDelay = `${i * 80}ms`;
    observer.observe(el);
  });
</script>
