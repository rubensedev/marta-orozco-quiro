---
import { Image } from "astro:assets";
import { treatments, massagesContent } from "../data/site";
import type { ImageMetadata } from "astro";

import relajanteImg from "../assets/images/relajante.webp";
import detoxImg from "../assets/images/detox.webp";
import descontracturanteImg from "../assets/images/descontracturante.webp";
import craneofacialImg from "../assets/images/craneofacial.webp";

const imageMap: Record<string, ImageMetadata> = {
  relajante: relajanteImg,
  detox: detoxImg,
  descontracturante: descontracturanteImg,
  "craneo-facial": craneofacialImg,
};

const first = treatments[0];
const firstImage = imageMap[first.id];
---

<section
  id="masajes"
  class="mx-auto w-[min(1120px,calc(100%-2rem))] overflow-visible py-[clamp(3rem,8vh,6rem)] md:px-6 lg:px-8"
>
  <div class="mb-10 w-full">
    <h2
      class="m-0 font-serif text-[clamp(2.25rem,4vw,3.5rem)] leading-[1.1] font-light"
    >
      {massagesContent.heading}
    </h2>
    <p class="mt-4 mb-0 text-lg leading-[1.8] text-brand-muted">
      {massagesContent.description}
    </p>
  </div>

  <!-- Main panel: content card left, floating image right -->
  <article
    id="massageMainPanel"
    class="massage-main-panel massage-card-reveal flex flex-col gap-8 lg:flex-row lg:items-center lg:gap-10"
    data-pricing-card={first.id}
    data-treatment={first.bookingValue}
  >
    <div
      class="massage-main-panel__content min-w-0 rounded-[1.75rem] p-6 shadow-soft sm:p-7 lg:flex-1 lg:p-8"
    >
      <h3
        id="panelTitle"
        class="m-0 wrap-break-word font-serif text-[clamp(1.35rem,2.8vw,2rem)] font-light tracking-[0.04em] uppercase"
      >
        {first.title}
      </h3>
      <div
        class="mt-3"
        data-pricing-display
        aria-live="polite"
        aria-atomic="true"
      >
      </div>
      <p
        id="panelDescription"
        class="mt-3 mb-0 text-[0.95rem] leading-[1.55] text-brand-muted"
      >
        {first.description}
      </p>
      <div class="mt-5" data-pricing-mount></div>
      <button
        id="panelBookingBtn"
        class="btn-brand mt-5 w-full uppercase tracking-[0.08em] sm:w-auto"
        type="button"
        data-open-booking
        data-treatment={first.bookingValue}
      >
        Reservar {first.title}
      </button>
    </div>

    <div
      class="massage-main-panel__image relative mx-auto w-full max-w-sm min-w-0 lg:mx-0 lg:w-[38%] lg:max-w-none lg:shrink-0"
      id="panelImageWrapper"
    >
      <Image
        id="panelImage"
        src={firstImage}
        alt={first.imageAlt}
        width={720}
        height={900}
        class="aspect-4/5 h-full w-full rounded-[1.75rem] object-cover"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </article>

  <!-- Horizontal carousel -->
  <div class="massage-carousel mt-10" id="massageCarousel">
    <div class="massage-carousel__viewport">
      <div
        class="massage-carousel__track"
        id="massageCarouselTrack"
        tabindex="0"
        role="listbox"
        aria-label="Tipos de masaje"
      >
        {
          treatments.map((treatment, i) => {
            const img = imageMap[treatment.id];
            const basePrice = treatment.durations[0].price;
            return (
              <button
                type="button"
                role="option"
                class:list={[
                  "massage-carousel-card group relative flex cursor-pointer flex-row items-stretch overflow-visible rounded-2xl border border-brand-sage/14 bg-white/60 text-left shadow-soft transition duration-300 ease-out hover:-translate-y-0.5 hover:shadow-xl dark:border-white/10 dark:bg-brand-card-dark/84 massage-card-reveal",
                  i === 0 ? "is-selected" : "",
                ]}
                data-carousel-card={treatment.id}
                data-treatment-id={treatment.id}
                data-treatment-index={i}
                aria-selected={i === 0 ? "true" : "false"}
                aria-pressed={i === 0 ? "true" : "false"}
              >
                <div class="massage-carousel-card__media">
                  <Image
                    src={img}
                    alt={treatment.imageAlt}
                    width={480}
                    height={640}
                    densities={[1, 2]}
                    class="massage-carousel-card__image"
                    loading="lazy"
                  />
                </div>
                <div class="flex min-w-0 flex-1 flex-col justify-center overflow-hidden py-4 pr-4 pl-0">
                  <h3 class="m-0 line-clamp-2 wrap-break-word font-serif text-base font-semibold tracking-[0.04em] text-brand-sage uppercase dark:text-brand-text-light">
                    {treatment.title}
                  </h3>
                  <p class="mt-1.5 mb-0 line-clamp-2 text-sm leading-snug text-brand-muted">
                    {treatment.description}
                  </p>
                  <p class="massage-carousel-card__price mt-3 mb-0 text-sm font-semibold text-brand-sage transition duration-300 ease-out dark:text-brand-sage-bright">
                    desde {basePrice}€ →
                  </p>
                </div>
              </button>
            );
          })
        }
      </div>

      <button
        type="button"
        class="massage-carousel__nav massage-carousel__nav--prev"
        id="massageCarouselPrev"
        aria-controls="massageCarouselTrack"
        aria-label="Masaje anterior"
      >
        <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
      </button>
      <button
        type="button"
        class="massage-carousel__nav massage-carousel__nav--next"
        id="massageCarouselNext"
        aria-controls="massageCarouselTrack"
        aria-label="Masaje siguiente"
      >
        <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
      </button>
    </div>
  </div>
</section>

<script>
  const panel = document.getElementById(
    "massageMainPanel",
  ) as HTMLElement | null;
  const track = document.getElementById(
    "massageCarouselTrack",
  ) as HTMLElement | null;
  const prevBtn = document.getElementById(
    "massageCarouselPrev",
  ) as HTMLButtonElement | null;
  const nextBtn = document.getElementById(
    "massageCarouselNext",
  ) as HTMLButtonElement | null;
  const panelTitle = document.getElementById(
    "panelTitle",
  ) as HTMLElement | null;
  const panelDesc = document.getElementById(
    "panelDescription",
  ) as HTMLElement | null;
  const panelImg = document.getElementById(
    "panelImage",
  ) as HTMLImageElement | null;
  const panelBookingBtn = document.getElementById(
    "panelBookingBtn",
  ) as HTMLButtonElement | null;

  const cards = Array.from(
    track?.querySelectorAll<HTMLButtonElement>("[data-carousel-card]") ?? [],
  );
  const treatmentIds = cards.map((c) => c.dataset.carouselCard!);

  const imgSrcMap: Record<string, string> = {};
  const imgAltMap: Record<string, string> = {};
  cards.forEach((card) => {
    const id = card.dataset.carouselCard!;
    const img = card.querySelector("img");
    if (img) {
      imgSrcMap[id] = img.currentSrc || img.src;
      imgAltMap[id] = img.alt;
    }
  });

  let activeIndex = 0;
  let switching = false;
  const prefersReduced = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  function setActiveCard(index: number) {
    cards.forEach((card, i) => {
      const on = i === index;
      card.classList.toggle("is-selected", on);
      card.setAttribute("aria-pressed", String(on));
      card.setAttribute("aria-selected", String(on));
    });
    const active = cards[index];
    if (active && track) {
      const left =
        active.offsetLeft - (track.clientWidth - active.offsetWidth) / 2;
      track.scrollTo({
        left: Math.max(0, left),
        behavior: prefersReduced ? "auto" : "smooth",
      });
    }
    updateNavButtons();
  }

  function switchTreatment(id: string) {
    if (!panel || switching) return;
    const w = window as any;
    const list: any[] = w.treatments ?? [];
    const treatment = list.find((t: any) => t.id === id);
    if (!treatment) return;

    const nextIndex = treatmentIds.indexOf(id);
    if (nextIndex === activeIndex && panel.dataset.pricingCard === id) {
      setActiveCard(nextIndex);
      return;
    }

    activeIndex = nextIndex >= 0 ? nextIndex : activeIndex;
    setActiveCard(activeIndex);

    switching = true;
    panel.style.transition = "none";
    panel.style.opacity = "0";
    panel.style.transform = prefersReduced ? "none" : "translateY(8px)";

    const delay = prefersReduced ? 0 : 180;
    setTimeout(() => {
      panel.dataset.pricingCard = id;
      panel.dataset.treatment = treatment.bookingValue;
      delete panel.dataset.selectedDuration;
      delete panel.dataset.selectedBono;

      if (panelTitle) panelTitle.textContent = treatment.title;
      if (panelDesc) panelDesc.textContent = treatment.description;
      if (panelBookingBtn) {
        panelBookingBtn.dataset.treatment = treatment.bookingValue;
        panelBookingBtn.textContent = `Reservar ${treatment.title}`;
      }
      if (panelImg && imgSrcMap[id]) {
        panelImg.src = imgSrcMap[id];
        panelImg.alt = imgAltMap[id] ?? "";
      }

      if (typeof w.renderPricingWidgets === "function")
        w.renderPricingWidgets();

      if (!prefersReduced) {
        panel.style.transition = "opacity 0.3s ease, transform 0.3s ease";
      }
      panel.style.opacity = "1";
      panel.style.transform = "translateY(0)";
      switching = false;
    }, delay);
  }

  function updateNavButtons() {
    if (!track || !prevBtn || !nextBtn) return;
    const maxScroll = track.scrollWidth - track.clientWidth;
    const needsNav = maxScroll > 8;

    prevBtn.hidden = !needsNav;
    nextBtn.hidden = !needsNav;
    if (!needsNav) return;

    prevBtn.disabled = track.scrollLeft <= 4;
    nextBtn.disabled = track.scrollLeft >= maxScroll - 4;
  }

  function scrollTrackBy(dir: -1 | 1) {
    if (!track) return;
    const card = cards[0];
    const step = card
      ? card.offsetWidth + parseFloat(getComputedStyle(track).gap || "16")
      : track.clientWidth * 0.8;
    track.scrollBy({
      left: dir * step,
      behavior: prefersReduced ? "auto" : "smooth",
    });
  }

  let dragging = false;
  let dragStartX = 0;
  let dragScrollLeft = 0;
  let dragMoved = false;

  track?.addEventListener("pointerdown", (e) => {
    if (e.button !== 0) return;
    dragging = true;
    dragMoved = false;
    dragStartX = e.clientX;
    dragScrollLeft = track.scrollLeft;
    track.setPointerCapture(e.pointerId);
    track.classList.add("is-dragging");
  });

  track?.addEventListener("pointermove", (e) => {
    if (!dragging) return;
    const dx = e.clientX - dragStartX;
    if (Math.abs(dx) > 4) dragMoved = true;
    track.scrollLeft = dragScrollLeft - dx;
  });

  function endDrag(e: PointerEvent) {
    if (!dragging) return;
    dragging = false;
    track?.classList.remove("is-dragging");
    try {
      track?.releasePointerCapture(e.pointerId);
    } catch {
      /* already released */
    }
  }

  track?.addEventListener("pointerup", endDrag);
  track?.addEventListener("pointercancel", endDrag);

  cards.forEach((card) => {
    card.addEventListener("click", (e) => {
      if (dragMoved) {
        e.preventDefault();
        dragMoved = false;
        return;
      }
      switchTreatment(card.dataset.carouselCard!);
    });
  });

  prevBtn?.addEventListener("click", () => scrollTrackBy(-1));
  nextBtn?.addEventListener("click", () => scrollTrackBy(1));
  track?.addEventListener("scroll", () => updateNavButtons(), {
    passive: true,
  });

  window.addEventListener("resize", () => updateNavButtons(), {
    passive: true,
  });

  const revealEls = document.querySelectorAll<HTMLElement>(
    ".massage-card-reveal",
  );
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          (entry.target as HTMLElement).classList.add("massage-card-visible");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12 },
  );
  revealEls.forEach((el, i) => {
    el.style.transitionDelay = `${i * 80}ms`;
    observer.observe(el);
  });

  setActiveCard(0);
  updateNavButtons();
</script>
