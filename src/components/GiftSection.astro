---
import { Image } from "astro:assets";
import type { SiteBundle } from "../data/site";
import SectionHeading from "./SectionHeading.astro";
import giftCardFront from "../assets/images/gift-card-front.webp";
import giftCardBack from "../assets/images/gift-card-back.webp";

type Props = {
  site: SiteBundle;
};

const { site } = Astro.props;
const { gift, sectionIds } = site;
---

<section
  id={sectionIds.gift}
  class="mx-auto w-[min(1120px,calc(100%-2rem))] py-[clamp(3rem,8vh,6rem)] md:px-6 lg:px-8"
  data-gift-section
>
  <SectionHeading title={gift.heading} />

  <div
    class="gift-reveal isolate grid items-center gap-10 rounded-4xl border border-glass-edge bg-glass-surface p-8 shadow-glass backdrop-blur-glass-panel md:grid-cols-[minmax(0,1.1fr)_minmax(14rem,0.9fr)] md:gap-12 md:p-10 dark:shadow-[var(--shadow-glass-dark)]"
  >
    <div class="min-w-0">
      <p class="m-0 leading-[1.8] text-brand-muted">{gift.body}</p>
      <button class="btn-brand mt-8" type="button" data-open-gift>
        <i class="fa-solid fa-gift" aria-hidden="true"></i>
        {gift.cta}
      </button>
    </div>

    <div class="flex justify-center md:justify-end">
      <button
        type="button"
        class="gift-card relative w-full max-w-[18rem] cursor-pointer border-0 bg-transparent p-0 text-left focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-sage"
        data-gift-card
        data-open-gift
        aria-pressed="false"
        aria-label={gift.cta}
      >
        <span class="gift-card__stage block w-full" style={`aspect-ratio: ${giftCardFront.width} / ${giftCardFront.height}`}>
          <span class="gift-card__inner relative block h-full w-full">
            <span class="gift-card__face gift-card__face--front">
              <Image
                src={giftCardFront}
                alt={gift.cardFrontAlt}
                widths={[288, 384, 560]}
                sizes="(max-width: 768px) min(70vw, 18rem), 18rem"
                class="gift-card__image"
                loading="lazy"
                decoding="async"
              />
            </span>
            <span class="gift-card__face gift-card__face--back" aria-hidden="true">
              <Image
                src={giftCardBack}
                alt=""
                widths={[288, 384, 560]}
                sizes="(max-width: 768px) min(70vw, 18rem), 18rem"
                class="gift-card__image"
                loading="lazy"
                decoding="async"
              />
            </span>
          </span>
        </span>
      </button>
    </div>
  </div>
</section>

<style>
  .gift-reveal {
    transition:
      opacity 0.9s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      transform 0.9s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(html.js) .gift-reveal:not(.is-visible) {
    opacity: 0;
    transform: translateY(14px);
  }

  .gift-card {
    perspective: 1400px;
    /* Identity transforms — avoid stacking-context jump on hover */
    translate: 0 0;
    transition:
      translate 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    filter: drop-shadow(0 10px 18px rgb(45 35 55 / 0.14));
  }

  .gift-card__inner {
    transform-style: preserve-3d;
    rotate: y 0deg;
    transition: rotate 0.75s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .gift-card__face {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 1.15rem;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.35) inset,
      0 12px 28px rgb(45 35 55 / 0.12);
  }

  .gift-card__face--front {
    rotate: y 0deg;
  }

  .gift-card__face--back {
    rotate: y 180deg;
  }

  .gift-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
  }

  .gift-card.is-flipped {
    translate: 0 -0.85rem;
    filter: drop-shadow(0 22px 34px rgb(45 35 55 / 0.22));
  }

  .gift-card.is-flipped .gift-card__inner {
    rotate: y 180deg;
  }

  @media (hover: hover) and (pointer: fine) {
    .gift-card:hover {
      translate: 0 -0.85rem;
      filter: drop-shadow(0 22px 34px rgb(45 35 55 / 0.22));
    }

    .gift-card:hover .gift-card__inner {
      rotate: y 180deg;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .gift-reveal:not(.is-visible),
    .gift-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .gift-card,
    .gift-card__inner {
      transition: none;
    }

    .gift-card.is-flipped,
    .gift-card:hover {
      translate: 0 0;
      filter: drop-shadow(0 10px 18px rgb(45 35 55 / 0.14));
    }

    .gift-card.is-flipped .gift-card__inner,
    .gift-card:hover .gift-card__inner {
      rotate: y 0deg;
    }

    .gift-card.is-flipped .gift-card__face--front,
    .gift-card:hover .gift-card__face--front {
      opacity: 0;
    }

    .gift-card.is-flipped .gift-card__face--back,
    .gift-card:hover .gift-card__face--back {
      opacity: 1;
      rotate: y 0deg;
    }

    .gift-card__face--back {
      opacity: 0;
      rotate: y 0deg;
    }
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12 },
  );

  document.querySelectorAll("[data-gift-section] .gift-reveal").forEach((el) => {
    observer.observe(el);
  });

  document.querySelectorAll<HTMLButtonElement>("[data-gift-card]").forEach((card) => {
    card.addEventListener("click", () => {
      const flipped = card.classList.toggle("is-flipped");
      card.setAttribute("aria-pressed", String(flipped));
    });
  });
</script>
