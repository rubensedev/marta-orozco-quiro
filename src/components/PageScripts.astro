---
import type { SiteBundle } from "../data/site";

type Props = {
  site: SiteBundle;
};

const { site } = Astro.props;
const { bonoTiers, rituals, meta: siteMeta, treatments, ui } = site;

const uiClient = {
  durationLabel: ui.durationLabel,
  purchaseTypeLabel: ui.purchaseTypeLabel,
  minutesSuffix: ui.minutesSuffix,
  perSession: ui.perSession,
  youSaveTemplate: site.locale === "en" ? "You save {amount} €" : "Ahorras {amount} €",
  openMenu: ui.nav.openMenu,
  closeMenu: ui.nav.closeMenu,
  whatsappBooking: ui.whatsappBooking,
};
---

<script
  define:vars={{
    bonoTiers,
    rituals,
    siteMeta,
    treatments,
    uiClient,
  }}
>
  const THEME_KEY = "marta-orozco-theme";
  const html = document.documentElement;
  const dialog = document.getElementById("bookingModal");
  const bookingForm = document.getElementById("bookingForm");
  const modalTreatment = document.getElementById("modalTreatment");
  const modalDuration = document.getElementById("modalDuration");
  const modalPurchaseType = document.getElementById("modalPurchaseType");
  const modalPriceEstimate = document.getElementById("modalPriceEstimate");
  const modalPriceSavings = document.getElementById("modalPriceSavings");
  const modalName = document.getElementById("modalName");
  const modalEmail = document.getElementById("modalEmail");
  const modalDate = document.getElementById("modalDate");
  const modalDurationGroup = document.getElementById("modalDurationGroup");
  const modalPurchaseTypeGroup = document.getElementById("modalPurchaseTypeGroup");
  const mobileMenuBtn = document.getElementById("mobileMenuBtn");
  const mobileMenu = document.getElementById("mobileMenu");
  const mobileMenuIcon = mobileMenuBtn?.querySelector("[data-mobile-menu-icon]");
  const mobileNavBackdrop = document.querySelector("[data-mobile-nav-backdrop]");
  const themeMenuButtons = document.querySelectorAll("[data-theme-menu-btn]");
  const themeMenus = document.querySelectorAll("[data-theme-menu]");
  const themeIcons = document.querySelectorAll("[data-theme-menu-icon]");
  const pageInertTargets = [
    document.querySelector("main"),
    document.querySelector("footer"),
    document.querySelector("aside.fixed"),
  ].filter(Boolean);

  const ritualMap = new Map(rituals.map((ritual) => [ritual.id, ritual]));
  const treatmentMap = new Map(treatments.map((treatment) => [treatment.id, treatment]));

  const themeIconClasses = {
    light: "fa-solid fa-sun text-amber-500",
    dark: "fa-solid fa-moon text-indigo-400",
    system: "fa-solid fa-circle-half-stroke text-slate-600 dark:text-amber-300",
  };

  function resolveTheme(preference) {
    const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
    return preference === "dark" || (preference === "system" && prefersDark);
  }

  function updateThemeMenu(preference) {
    document.querySelectorAll("[data-theme-option]").forEach((button) => {
      const selected = button.dataset.themeOption === preference;
      button.setAttribute("aria-checked", String(selected));
    });
    const iconClass = themeIconClasses[preference] || themeIconClasses.system;
    themeIcons.forEach((icon) => {
      icon.className = iconClass;
    });
  }

  function applyThemePreference(preference) {
    const actualPreference = preference || "system";
    html.classList.toggle("dark", resolveTheme(actualPreference));
    localStorage.setItem(THEME_KEY, actualPreference);
    updateThemeMenu(actualPreference);
  }

  function isNavOpen() {
    return mobileMenuBtn?.getAttribute("aria-expanded") === "true";
  }

  function syncBodyLock() {
    document.body.classList.toggle("is-locked", isNavOpen() || Boolean(dialog?.open));
  }

  function setPageInert(inert) {
    pageInertTargets.forEach((node) => {
      node.toggleAttribute("inert", inert);
    });
  }

  function closeAllThemeMenus() {
    themeMenus.forEach((menu) => {
      menu.hidden = true;
    });
    themeMenuButtons.forEach((button) => {
      button.setAttribute("aria-expanded", "false");
    });
  }

  function closeAllLangMenus() {
    if (typeof window.__closeAllLangMenus === "function") {
      window.__closeAllLangMenus();
    }
  }

  function menuForThemeButton(button) {
    return document.getElementById(button.getAttribute("aria-controls"));
  }

  function toggleThemeMenu(button, forceOpen) {
    const menu = menuForThemeButton(button);
    if (!menu) return;

    const open = forceOpen ?? menu.hidden;
    closeAllThemeMenus();
    closeAllLangMenus();

    if (open) {
      menu.hidden = false;
      button.setAttribute("aria-expanded", "true");
    }
  }

  function toggleMobileMenu(forceOpen) {
    if (!mobileMenu || !mobileMenuBtn) return;

    const open = forceOpen ?? !isNavOpen();
    mobileMenu.toggleAttribute("data-open", open);
    mobileNavBackdrop?.toggleAttribute("data-open", open);
    mobileMenu.toggleAttribute("inert", !open);
    mobileMenu.setAttribute("aria-hidden", String(!open));
    mobileMenuBtn.setAttribute("aria-expanded", String(open));
    mobileMenuBtn.setAttribute(
      "aria-label",
      open ? uiClient.closeMenu : uiClient.openMenu,
    );

    if (mobileMenuIcon) {
      mobileMenuIcon.className = open ? "fa-solid fa-xmark" : "fa-solid fa-bars";
    }

    setPageInert(open);
    closeAllThemeMenus();
    closeAllLangMenus();
    syncBodyLock();
  }

  function getSelectedTier(card) {
    return bonoTiers.find((tier) => tier.id === card.dataset.selectedBono) ?? bonoTiers[0];
  }

  function getSelectedDuration(card, treatment) {
    const minutes = Number(card.dataset.selectedDuration);
    return treatment.durations.find((duration) => duration.min === minutes) ?? treatment.durations[0];
  }

  function calculateQuote(unitPrice, tier) {
    const fullTotal = unitPrice * tier.sessions;
    const discountedTotal = Math.round(fullTotal * (1 - tier.discount));
    const perSession = tier.sessions > 1 ? Math.round(discountedTotal / tier.sessions) : unitPrice;
    const savings = fullTotal - discountedTotal;

    return { discountedTotal, fullTotal, perSession, savings };
  }

  function renderPriceDisplay(card, treatment) {
    const display = card.querySelector("[data-pricing-display]");
    const tier = getSelectedTier(card);
    const duration = getSelectedDuration(card, treatment);
    const quote = calculateQuote(duration.price, tier);

    if (tier.sessions === 1) {
      display.innerHTML = `<div class="pricing-compare"><p class="pricing-single">${duration.price} €</p></div>`;
      return;
    }

    const saveLabel = String(uiClient.youSaveTemplate).replace(
      "{amount}",
      String(quote.savings),
    );

    display.innerHTML = `
      <div class="pricing-compare">
        <div class="pricing-compare-figures">
          <span class="pricing-original">${quote.fullTotal} €</span>
          <span class="pricing-discounted">${quote.discountedTotal} €</span>
        </div>
        <p class="pricing-per-session">${quote.perSession} € ${uiClient.perSession}</p>
        <p class="pricing-savings-highlight"><i class="fa-solid fa-tag" aria-hidden="true"></i> ${saveLabel}</p>
      </div>
    `;
  }

  function renderPillGroup({ label, items, onClick, selectedValue, bono = false }) {
    return `
      <div class="pricing-card__group">
        <p class="pricing-card__group-title">${label}</p>
        <div class="pricing-card__pill-row" role="radiogroup" aria-label="${label}">
          ${items
            .map((item) => {
              const active = item.value === selectedValue;
              const bonusClass = bono ? " pricing-pill-bono" : "";
              const activeClass = active ? " pricing-pill-active" : "";
              return `<button type="button" class="pricing-pill${bonusClass}${activeClass}" data-role="${onClick}" data-value="${item.value}" aria-pressed="${active}">${item.label}</button>`;
            })
            .join("")}
        </div>
      </div>
    `;
  }

  function renderPricingWidgets() {
    document.querySelectorAll("[data-pricing-card]").forEach((card) => {
      const treatment = treatments.find((entry) => entry.id === card.dataset.pricingCard);
      if (!treatment) return;

      card.dataset.selectedDuration ||= String(treatment.durations[0].min);
      card.dataset.selectedBono ||= bonoTiers[0].id;

      const mount = card.querySelector("[data-pricing-mount]");
      mount.innerHTML =
        renderPillGroup({
          label: uiClient.durationLabel,
          items: treatment.durations.map((duration) => ({
            value: String(duration.min),
            label: `${duration.min} min`,
          })),
          onClick: "duration",
          selectedValue: card.dataset.selectedDuration,
        }) +
        renderPillGroup({
          label: uiClient.purchaseTypeLabel,
          items: bonoTiers.map((tier) => ({
            value: tier.id,
            label: tier.shortLabel,
          })),
          onClick: "bono",
          selectedValue: card.dataset.selectedBono,
          bono: true,
        });

      mount.querySelectorAll("[data-role='duration']").forEach((button) => {
        button.addEventListener("click", () => {
          card.dataset.selectedDuration = button.dataset.value;
          renderPricingWidgets();
        });
      });

      mount.querySelectorAll("[data-role='bono']").forEach((button) => {
        button.addEventListener("click", () => {
          card.dataset.selectedBono = button.dataset.value;
          renderPricingWidgets();
        });
      });

      renderPriceDisplay(card, treatment);
    });
  }

  function formatSaveLabel(amount) {
    return String(uiClient.youSaveTemplate).replace("{amount}", String(amount));
  }

  function setModalPriceSavings(amount) {
    if (!modalPriceSavings) return;
    if (!amount) {
      modalPriceSavings.hidden = true;
      modalPriceSavings.textContent = "";
      return;
    }

    const saveLabel = formatSaveLabel(amount);
    modalPriceSavings.hidden = false;
    modalPriceSavings.innerHTML = `<i class="fa-solid fa-tag" aria-hidden="true"></i> ${saveLabel}`;
  }

  function syncBookingFieldVisibility() {
    const selectedId = modalTreatment.value;
    const ritual = ritualMap.get(selectedId);
    const treatment = treatmentMap.get(selectedId);

    if (ritual) {
      modalDurationGroup.hidden = true;
      modalPurchaseTypeGroup.hidden = true;
      modalDuration.innerHTML = `<option value="${ritual.duration}">${ritual.duration} ${uiClient.minutesSuffix}</option>`;
      modalPurchaseType.value = "single";
      modalPriceEstimate.value = `${ritual.price} €`;
      setModalPriceSavings(0);
      return;
    }

    if (!treatment) return;

    modalDurationGroup.hidden = false;
    modalPurchaseTypeGroup.hidden = false;
    modalDuration.innerHTML = treatment.durations
      .map(
        (duration) =>
          `<option value="${duration.min}">${duration.min} ${uiClient.minutesSuffix}</option>`,
      )
      .join("");

    updateModalPriceEstimate();
  }

  function updateModalPriceEstimate() {
    const treatment = treatmentMap.get(modalTreatment.value);
    if (!treatment) return;

    const duration =
      treatment.durations.find((entry) => entry.min === Number(modalDuration.value)) ??
      treatment.durations[0];
    const tier = bonoTiers.find((entry) => entry.id === modalPurchaseType.value) ?? bonoTiers[0];
    const quote = calculateQuote(duration.price, tier);
    modalPriceEstimate.value =
      tier.sessions === 1
        ? `${duration.price} €`
        : `${quote.discountedTotal} € (${quote.perSession} € ${uiClient.perSession})`;
    setModalPriceSavings(tier.sessions > 1 ? quote.savings : 0);
  }

  function openBookingModal(treatmentId, context = {}) {
    if (treatmentId) {
      const match = [...modalTreatment.options].find(
        (option) => option.value === treatmentId,
      );
      if (match) modalTreatment.value = match.value;
    }

    // Pack CTAs need a massage treatment so purchase type stays visible.
    if (context.bono) {
      const current = modalTreatment.value;
      if (ritualMap.has(current) || !treatmentMap.has(current)) {
        modalTreatment.value = treatments[0].id;
      }
    }

    syncBookingFieldVisibility();

    if (context.duration && !modalDurationGroup.hidden) {
      modalDuration.value = String(context.duration);
    }

    if (context.bono && !modalPurchaseTypeGroup.hidden) {
      modalPurchaseType.value = context.bono;
    }

    updateModalPriceEstimate();
    dialog.showModal();
    syncBodyLock();
  }

  function closeBookingModal() {
    dialog.close();
    syncBodyLock();
  }

  function bookingMessage() {
    const wb = uiClient.whatsappBooking;
    const purchaseTypeLabel =
      bonoTiers.find((entry) => entry.id === modalPurchaseType.value)?.label ??
      wb.defaultSingle;
    const estimate = modalPriceEstimate.value;
    const durationLabel = modalDurationGroup.hidden
      ? wb.defaultDuration
      : `${modalDuration.value} ${uiClient.minutesSuffix}`;

    const selectedOption = [...modalTreatment.options].find(
      (option) => option.value === modalTreatment.value,
    );
    const treatmentLabel = selectedOption?.textContent?.trim() || modalTreatment.value;

    return [
      wb.greeting,
      "",
      `• *${wb.treatment}:* ${treatmentLabel}`,
      `• *${wb.duration}:* ${durationLabel}`,
      `• *${wb.purchaseType}:* ${purchaseTypeLabel}`,
      estimate ? `• *${wb.priceEstimate}:* ${estimate}` : "",
      `• *${wb.name}:* ${modalName.value}`,
      `• *${wb.email}:* ${modalEmail.value}`,
      `• *${wb.datePreference}:* ${modalDate.value}`,
    ]
      .filter(Boolean)
      .join("\n");
  }

  document.querySelectorAll("[data-theme-option]").forEach((button) => {
    button.addEventListener("click", () => {
      applyThemePreference(button.dataset.themeOption);
      closeAllThemeMenus();
    });
  });

  themeMenuButtons.forEach((button) => {
    button.addEventListener("click", (event) => {
      event.stopPropagation();
      toggleThemeMenu(button);
    });
  });
  mobileMenuBtn?.addEventListener("click", () => toggleMobileMenu());
  mobileNavBackdrop?.addEventListener("click", () => toggleMobileMenu(false));

  document.querySelectorAll("[data-close-mobile-nav]").forEach((link) => {
    link.addEventListener("click", () => toggleMobileMenu(false));
  });

  document.querySelectorAll("[data-open-booking-close-nav]").forEach((button) => {
    button.addEventListener("click", () => {
      toggleMobileMenu(false);
      openBookingModal();
    });
  });

  document.querySelectorAll("[data-open-booking]").forEach((button) => {
    button.addEventListener("click", () => {
      const treatmentId = button.dataset.treatment;
      const card = button.closest("[data-pricing-card]");
      const context = card
        ? {
            duration: Number(card.dataset.selectedDuration),
            bono: card.dataset.selectedBono,
          }
        : {};

      if (button.dataset.bono) {
        context.bono = button.dataset.bono;
      }

      openBookingModal(treatmentId, context);
    });
  });

  document.querySelectorAll("[data-close-booking]").forEach((button) => {
    button.addEventListener("click", closeBookingModal);
  });

  dialog?.addEventListener("click", (event) => {
    const rect = dialog.getBoundingClientRect();
    const inDialog =
      rect.top <= event.clientY &&
      event.clientY <= rect.top + rect.height &&
      rect.left <= event.clientX &&
      event.clientX <= rect.left + rect.width;
    if (!inDialog) closeBookingModal();
  });

  dialog?.addEventListener("close", () => {
    syncBodyLock();
  });

  modalTreatment?.addEventListener("change", () => {
    syncBookingFieldVisibility();
    updateModalPriceEstimate();
  });
  modalDuration?.addEventListener("change", updateModalPriceEstimate);
  modalPurchaseType?.addEventListener("change", updateModalPriceEstimate);

  bookingForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    const url = `https://wa.me/${siteMeta.whatsappNumber}?text=${encodeURIComponent(bookingMessage())}`;
    window.open(url, "_blank", "noopener,noreferrer");
  });

  document.addEventListener("click", (event) => {
    const insideThemeWidget = event.target.closest("[data-theme-widget]");
    if (!insideThemeWidget) closeAllThemeMenus();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    closeAllThemeMenus();
    closeAllLangMenus();
    toggleMobileMenu(false);
  });

  window.matchMedia("(min-width: 64rem)").addEventListener("change", (event) => {
    if (event.matches) toggleMobileMenu(false);
  });

  window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
    const preference = localStorage.getItem(THEME_KEY) || "system";
    if (preference === "system") {
      applyThemePreference("system");
    }
  });

  const siteHeader = document.querySelector("header");
  const headerSentinel = document.querySelector("[data-header-sentinel]");
  if (siteHeader && headerSentinel) {
    const syncHeaderFill = (isSentinelVisible) => {
      siteHeader.toggleAttribute("data-scrolled", !isSentinelVisible);
    };

    syncHeaderFill(true);
    new IntersectionObserver(
      ([entry]) => {
        syncHeaderFill(entry.isIntersecting);
      },
      { threshold: 0 },
    ).observe(headerSentinel);
  }

  window.treatments = treatments;
  window.renderPricingWidgets = renderPricingWidgets;
  window.openBookingModal = openBookingModal;

  applyThemePreference(localStorage.getItem(THEME_KEY) || "system");
  syncBookingFieldVisibility();
  updateModalPriceEstimate();
  renderPricingWidgets();
</script>
