---
import type { SiteBundle } from "../data/site";
import SectionHeading from "./SectionHeading.astro";

type Props = {
  site: SiteBundle;
};

const { site } = Astro.props;
const { faq, sectionIds, meta } = site;

const linkClass =
  "cursor-pointer font-medium text-brand-sage underline-offset-2 transition-opacity hover:opacity-80 hover:underline focus-visible:underline dark:text-brand-sage-bright";

const inquiryWhatsappHref = `https://wa.me/${meta.whatsappNumber}?text=${encodeURIComponent(meta.whatsappInquiry)}`;
const bonosWhatsappHref = `https://wa.me/${meta.whatsappNumber}?text=${encodeURIComponent(meta.whatsappBonosInquiry)}`;
---

<section
  id={sectionIds.faq}
  class="mx-auto w-[min(1120px,calc(100%-2rem))] py-[clamp(3rem,8vh,6rem)] md:px-6 lg:px-8"
>
  <SectionHeading title={faq.heading} description={faq.description} />

  <div class="mx-auto max-w-3xl space-y-3">
    {
      faq.items.map((item) => (
        <details class="faq-item rounded-2xl border border-glass-edge bg-glass-surface p-5 shadow-glass backdrop-blur-glass-panel dark:shadow-[var(--shadow-glass-dark)]">
          <summary class="cursor-pointer list-none font-medium text-brand-text-dark dark:text-brand-text-light [&::-webkit-details-marker]:hidden">
            <span class="flex items-start justify-between gap-4">
              <span>{item.question}</span>
              <span
                class="faq-icon mt-0.5 shrink-0 text-brand-lavender dark:text-brand-lavender-bright"
                aria-hidden="true"
              >
                +
              </span>
            </span>
          </summary>
          <p class="mt-4 mb-0 leading-[1.75] text-brand-muted">
            {item.answer.map((part) =>
              typeof part === "string" ? (
                part
              ) : part.action === "booking" ? (
                <button class={linkClass} type="button" data-open-booking>
                  {part.label}
                </button>
              ) : part.action === "maps" ? (
                <a
                  class={linkClass}
                  href={meta.mapsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {part.label}
                </a>
              ) : part.action === "whatsapp" ? (
                <a
                  class={linkClass}
                  href={inquiryWhatsappHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-whatsapp-direct
                >
                  {part.label}
                </a>
              ) : part.action === "whatsappPackages" ? (
                <a
                  class={linkClass}
                  href={bonosWhatsappHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-whatsapp-direct
                >
                  {part.label}
                </a>
              ) : part.action === "packages" ? (
                <a class={linkClass} href={`#${sectionIds.packages}`}>
                  {part.label}
                </a>
              ) : (
                <a class={linkClass} href={`#${sectionIds.contact}`}>
                  {part.label}
                </a>
              ),
            )}
          </p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }

  .faq-icon {
    display: inline-block;
    transition: transform 0.2s ease;
    font-size: 1.25rem;
    line-height: 1;
  }

  details > summary:focus-visible {
    outline: 2px solid var(--color-brand-lavender);
    outline-offset: 4px;
    border-radius: 0.5rem;
  }
</style>
