---
import type { SiteBundle } from "../data/site";
import About from "./About.astro";
import BookingModal from "./BookingModal.astro";
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import Massages from "./Massages.astro";
import MobileBar from "./MobileBar.astro";
import PageScripts from "./PageScripts.astro";
import Reviews from "./Reviews.astro";
import Rituals from "./Rituals.astro";

type Props = {
  site: SiteBundle;
};

const { site } = Astro.props;
---

<Header site={site} />

<main id={site.sectionIds.home}>
  <Hero site={site} />
  <About site={site} />
  <Massages site={site} />
  <Rituals site={site} />
  <Reviews site={site} />
  <Contact site={site} />
</main>

<Footer site={site} />
<MobileBar site={site} />
<BookingModal site={site} />
<PageScripts site={site} />
