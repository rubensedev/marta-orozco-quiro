---
import type { SiteBundle } from "../data/site";
import SectionHeading from "./SectionHeading.astro";

type Props = {
  site: SiteBundle;
};

const { site } = Astro.props;
const {
  bonoExamples,
  bonoTiers,
  bonos: bonosContent,
  rituals,
  ritualsContent,
  treatments,
  sectionIds,
  meta,
} = site;

const bonosWhatsappHref = `https://wa.me/${meta.whatsappNumber}?text=${encodeURIComponent(meta.whatsappBonosInquiry)}`;

const packageTiers = bonoTiers.filter((tier) => tier.sessions > 1);

function calculateQuote(unitPrice: number, sessions: number, discount: number) {
  const fullTotal = unitPrice * sessions;
  const discountedTotal = Math.round(fullTotal * (1 - discount));
  return {
    fullTotal,
    discountedTotal,
    savings: fullTotal - discountedTotal,
  };
}

const exampleRows = bonoExamples.flatMap((example) => {
  const treatment = treatments.find(
    (entry) => entry.id === example.treatmentId,
  );
  const duration = treatment?.durations.find(
    (entry) => entry.min === example.durationMin,
  );
  const tier = bonoTiers.find((entry) => entry.id === example.bonoId);
  if (!treatment || !duration || !tier) return [];

  const quote = calculateQuote(duration.price, tier.sessions, tier.discount);
  return [
    {
      label: `${treatment.bookingValue} · ${duration.min} min · ${tier.label}`,
      ...quote,
    },
  ];
});
---

<section
  id={sectionIds.packages}
  class="mx-auto my-8 w-[min(1120px,calc(100%-2rem))] rounded-4xl bg-brand-bg py-16 md:px-6 md:py-20 lg:px-8 dark:bg-brand-bg-dark"
  data-packages-section
>
  <SectionHeading
    title={ritualsContent.heading}
    description={ritualsContent.description}
  />

  <div class="grid gap-6 lg:grid-cols-2 lg:gap-8">
    {
      rituals.map((ritual, index) => (
        <article
          class={`massage-card-reveal isolate flex flex-col items-center rounded-[1.75rem] border border-glass-edge bg-glass-panel-lavender px-7 py-10 text-center shadow-glass backdrop-blur-glass-panel md:px-10 md:py-12 dark:shadow-[var(--shadow-glass-dark)]`}
          style={`transition-delay: ${index * 120}ms`}
        >
          <div class="inline-flex size-12 items-center justify-center rounded-full border border-glass-edge bg-glass-control text-lg text-brand-lavender shadow-glass backdrop-blur-glass-control dark:shadow-[var(--shadow-glass-dark)]">
            <i class={ritual.iconClass} aria-hidden="true" />
          </div>
          <h3 class="mt-6 mb-0 font-serif text-[clamp(1.35rem,2.4vw,1.65rem)] leading-tight font-normal tracking-[0.04em] text-brand-lavender uppercase dark:text-brand-lavender-bright">
            {ritual.title}
          </h3>
          <p class="mt-4 mb-0 max-w-[34ch] text-[0.95rem] leading-[1.7] text-brand-muted">
            {ritual.description}
          </p>
          <div
            class="my-6 h-px w-full max-w-56 bg-brand-lavender/20 dark:bg-white/15"
            aria-hidden="true"
          />
          <p class="m-0 text-[0.95rem] font-semibold tracking-[0.04em] text-brand-lavender dark:text-brand-lavender-bright">
            {ritual.duration} min — {ritual.price} €
          </p>
          <button
            class="mt-6 inline-flex w-full max-w-xs cursor-pointer items-center justify-center rounded-full bg-brand-lavender px-6 py-3.5 text-[0.72rem] font-semibold tracking-[0.14em] text-white uppercase transition hover:bg-brand-lavender-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-lavender dark:hover:bg-brand-lavender"
            type="button"
            data-open-booking
            data-treatment={ritual.id}
          >
            {ritualsContent.ctaLabel}
          </button>
        </article>
      ))
    }
  </div>

  <section
    class="massage-card-reveal isolate mt-8 rounded-[1.75rem] border border-glass-edge bg-glass-surface-stone px-6 py-10 shadow-glass backdrop-blur-glass-panel sm:px-8 md:px-12 md:py-12 dark:shadow-[var(--shadow-glass-dark)]"
    style="transition-delay: 240ms"
    aria-labelledby="bonos-title"
  >
    <h3
      id="bonos-title"
      class="m-0 text-center font-serif text-[clamp(1.75rem,3vw,2.25rem)] font-light tracking-[0.06em] text-brand-text-dark uppercase dark:text-brand-text-light"
    >
      {bonosContent.heading}
    </h3>

    <div
      class="mx-auto mt-8 grid max-w-xl grid-cols-1 gap-8 sm:grid-cols-[1fr_auto_1fr] sm:items-start sm:gap-0"
    >
      {
        packageTiers.map((tier, index) => (
          <>
            {index > 0 && (
              <div
                class="mx-auto hidden h-full min-h-28 w-px bg-brand-muted/25 sm:block dark:bg-white/15"
                aria-hidden="true"
              />
            )}
            <article class="bono-package flex flex-col items-center text-center">
              {tier.id === "bono10" && (
                <span class="bono-featured-badge">
                  <span
                    class="bono-featured-badge__spark bono-featured-badge__spark--a"
                    aria-hidden="true"
                  ></span>
                  <span
                    class="bono-featured-badge__spark bono-featured-badge__spark--b"
                    aria-hidden="true"
                  ></span>
                  <span
                    class="bono-featured-badge__spark bono-featured-badge__spark--c"
                    aria-hidden="true"
                  ></span>
                  <span
                    class="bono-featured-badge__spark bono-featured-badge__spark--d"
                    aria-hidden="true"
                  ></span>
                  {bonosContent.bestValueLabel}
                </span>
              )}
              <h4 class="m-0 text-[0.95rem] font-semibold tracking-[0.12em] text-brand-text-dark uppercase dark:text-brand-text-light">
                {bonosContent.sessionsLabel(tier.sessions)}
              </h4>
              <button
                class="bono-discount mt-4"
                type="button"
                data-open-booking
                data-bono={tier.id}
                aria-label={
                  tier.id === "bono10"
                    ? `${bonosContent.bestValueLabel}. ${site.ui.reserveTreatment(tier.label)}`
                    : site.ui.reserveTreatment(tier.label)
                }
              >
                <span class="bono-discount__wave" aria-hidden="true"></span>
                <span
                  class="bono-discount__wave bono-discount__wave--late"
                  aria-hidden="true"
                ></span>
                <span class="bono-discount__core">
                  {Math.round(tier.discount * 100)}%
                </span>
              </button>
              <p class="mt-3 mb-0 text-[0.78rem] font-semibold tracking-[0.16em] text-brand-muted uppercase">
                {bonosContent.discountLabel}
              </p>
            </article>
          </>
        ))
      }
    </div>

    <div
      class="mx-auto mt-10 h-px max-w-3xl bg-brand-muted/20 dark:bg-white/12"
      aria-hidden="true"
    >
    </div>

    <h4
      class="mt-8 mb-0 text-center text-[0.78rem] font-semibold tracking-[0.18em] text-brand-muted uppercase"
    >
      {bonosContent.examplesHeading}
    </h4>

    <div class="mx-auto mt-6 grid max-w-3xl gap-4" id="bonoExamples">
      {
        exampleRows.map((row) => (
          <article class="bonos-example">
            <p class="bonos-example__label">{row.label}</p>
            <div class="bonos-example__prices">
              <span class="pricing-original">{row.fullTotal} €</span>
              <span class="pricing-discounted">{row.discountedTotal} €</span>
              <span class="pricing-savings-highlight">
                <i class="fa-solid fa-tag" aria-hidden="true" />-{row.savings} €
              </span>
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-10 flex justify-center">
      <a
        class="btn-brand"
        href={bonosWhatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        data-whatsapp-direct
      >
        <span>{bonosContent.ctaLabel}</span>
        <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
      </a>
    </div>
  </section>
</section>

<style>
  .bono-package {
    position: relative;
  }

  .bono-featured-badge {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0 0 0.5rem;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    border: 1px solid
      color-mix(in srgb, var(--color-brand-lavender) 28%, transparent);
    background: color-mix(in srgb, var(--color-brand-lavender) 12%, white);
    color: var(--color-brand-lavender-dark);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.2;
    text-transform: uppercase;
    white-space: nowrap;
  }

  :global(.dark) .bono-featured-badge {
    border-color: color-mix(
      in srgb,
      var(--color-brand-lavender-bright) 32%,
      transparent
    );
    background: color-mix(
      in srgb,
      var(--color-brand-lavender) 22%,
      transparent
    );
    color: var(--color-brand-lavender-bright);
  }

  /* amber-500 — same as theme switcher sun icon */
  .bono-featured-badge__spark {
    position: absolute;
    width: 0.75rem;
    height: 0.75rem;
    pointer-events: none;
    background: #f59e0b;
    clip-path: polygon(
      50% 0%,
      62% 38%,
      100% 50%,
      62% 62%,
      50% 100%,
      38% 62%,
      0% 50%,
      38% 38%
    );
    animation: bono-spark-twinkle 2.4s ease-in-out infinite;
  }

  .bono-featured-badge__spark--a {
    top: -0.45rem;
    left: 0.2rem;
    width: 0.62rem;
    height: 0.62rem;
    animation-delay: 0s;
  }

  .bono-featured-badge__spark--b {
    top: -0.3rem;
    right: 0.05rem;
    width: 0.72rem;
    height: 0.72rem;
    animation-delay: 0.6s;
  }

  .bono-featured-badge__spark--c {
    bottom: -0.38rem;
    left: -0.2rem;
    width: 0.55rem;
    height: 0.55rem;
    animation-delay: 1.2s;
  }

  .bono-featured-badge__spark--d {
    top: 0.05rem;
    right: -0.48rem;
    width: 0.48rem;
    height: 0.48rem;
    animation-delay: 1.8s;
  }

  @keyframes bono-spark-twinkle {
    0%,
    100% {
      opacity: 0.45;
      transform: scale(0.75);
    }
    50% {
      opacity: 1;
      transform: scale(1.05);
    }
  }

  @media (min-width: 640px) {
    /* Equal reserved band so both columns share the same title baseline */
    .bono-package {
      padding-top: 2rem;
    }

    .bono-featured-badge {
      position: absolute;
      top: 0;
      left: 50%;
      z-index: 1;
      margin: 0;
      transform: translateX(-50%);
    }
  }

  .bono-discount {
    position: relative;
    display: inline-flex;
    width: 4.5rem;
    height: 4.5rem;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    color: inherit;
  }

  .bono-discount:focus-visible {
    outline: 2px solid var(--color-brand-lavender);
    outline-offset: 4px;
    border-radius: 999px;
  }

  .bono-discount:hover .bono-discount__core {
    background: var(--color-brand-lavender-dark);
  }

  .bono-discount__core {
    position: relative;
    z-index: 1;
    display: inline-flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: var(--color-brand-lavender);
    color: var(--color-brand-text-light);
    font-size: 1.15rem;
    font-weight: 700;
  }

  .bono-discount__wave {
    position: absolute;
    inset: 0;
    border-radius: 999px;
    border: 1.5px solid color-mix(in srgb, var(--color-brand-lavender) 55%, transparent);
    pointer-events: none;
    animation: bono-discount-wave 3.2s cubic-bezier(0.22, 0.61, 0.36, 1) infinite;
  }

  .bono-discount__wave--late {
    animation-delay: 1.6s;
  }

  @keyframes bono-discount-wave {
    0% {
      transform: scale(1);
      opacity: 0.5;
    }
    70% {
      opacity: 0.12;
    }
    100% {
      transform: scale(1.55);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bono-discount__wave {
      animation: none;
      opacity: 0;
    }

    .bono-featured-badge__spark {
      animation: none;
      opacity: 0.85;
      transform: none;
    }
  }
</style>

<script>
  const revealEls = document.querySelectorAll(
    "[data-packages-section] .massage-card-reveal",
  );

  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("massage-card-visible");
        revealObserver.unobserve(entry.target);
      });
    },
    { threshold: 0.05 },
  );

  revealEls.forEach((el) => revealObserver.observe(el));
</script>
