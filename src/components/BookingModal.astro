---
import type { SiteBundle } from "../data/site";

type Props = {
  site: SiteBundle;
};

const { site } = Astro.props;
const { bookingOptions, bonoTiers, ui } = site;
---

<dialog
  id="bookingModal"
  class="booking-modal w-[min(680px,calc(100%-1rem))] max-w-full rounded-[2rem] border-0 bg-transparent p-0"
  aria-labelledby="bookingModalTitle"
>
  <article
    class="relative rounded-[2rem] bg-brand-bg p-8 shadow-soft md:p-10 dark:bg-brand-card-dark"
  >
    <button
      class="absolute top-5 right-5 inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border border-brand-sage/14 bg-transparent text-inherit"
      type="button"
      data-close-booking
      aria-label={ui.modal.closeAria}
    >
      <i class="fa-solid fa-xmark" aria-hidden="true"></i>
    </button>

    <p class="m-0 mb-4 inline-flex items-center gap-3 text-xs font-semibold tracking-[0.24em] text-brand-lavender uppercase">
      {ui.modal.eyebrow}
    </p>
    <h2
      id="bookingModalTitle"
      class="m-0 mb-6 font-serif text-3xl font-light uppercase"
    >
      {ui.modal.title}
    </h2>

    <form id="bookingForm" class="grid gap-5">
      <div class="booking-field-group">
        <label class="mb-2 block text-[0.9rem] font-semibold tracking-[0.12em] uppercase" for="modalTreatment">
          {ui.modal.treatmentLabel} <span class="text-brand-lavender">*</span>
        </label>
        <select
          id="modalTreatment"
          class="min-h-13 w-full rounded-2xl border border-brand-sage/14 bg-white/70 px-4 py-[0.85rem] text-inherit dark:bg-white/6"
          name="treatment"
          required
        >
          {
            bookingOptions.map((option) => (
              <option value={option.id}>{option.label}</option>
            ))
          }
        </select>
      </div>

      <div class="booking-field-group" id="modalDurationGroup">
        <label class="mb-2 block text-[0.9rem] font-semibold tracking-[0.12em] uppercase" for="modalDuration">
          {ui.modal.durationLabel} <span class="text-brand-lavender">*</span>
        </label>
        <select
          id="modalDuration"
          class="min-h-13 w-full rounded-2xl border border-brand-sage/14 bg-white/70 px-4 py-[0.85rem] text-inherit dark:bg-white/6"
          name="duration"
        ></select>
      </div>

      <div class="booking-field-group" id="modalPurchaseTypeGroup">
        <label class="mb-2 block text-[0.9rem] font-semibold tracking-[0.12em] uppercase" for="modalPurchaseType">
          {ui.modal.purchaseTypeLabel} <span class="text-brand-lavender">*</span>
        </label>
        <select
          id="modalPurchaseType"
          class="min-h-13 w-full rounded-2xl border border-brand-sage/14 bg-white/70 px-4 py-[0.85rem] text-inherit dark:bg-white/6"
          name="purchaseType"
        >
          {
            bonoTiers.map((tier) => (
              <option value={tier.id}>{tier.label}</option>
            ))
          }
        </select>
      </div>

      <div class="booking-field-group">
        <p class="mb-2 text-[0.9rem] font-semibold tracking-[0.12em] uppercase">{ui.modal.priceEstimateLabel}</p>
        <output
          id="modalPriceEstimate"
          class="inline-flex min-h-13 w-full items-center rounded-2xl border border-brand-sage/14 bg-white/70 px-4 py-[0.85rem] font-semibold text-brand-lavender dark:bg-white/6"
        >
          -
        </output>
      </div>

      <div class="booking-field-group">
        <label class="mb-2 block text-[0.9rem] font-semibold tracking-[0.12em] uppercase" for="modalName">
          {ui.modal.nameLabel} <span class="text-brand-lavender">*</span>
        </label>
        <input
          id="modalName"
          class="min-h-13 w-full rounded-2xl border border-brand-sage/14 bg-white/70 px-4 py-[0.85rem] text-inherit dark:bg-white/6"
          name="name"
          type="text"
          autocomplete="name"
          required
        />
      </div>

      <div class="booking-field-group">
        <label class="mb-2 block text-[0.9rem] font-semibold tracking-[0.12em] uppercase" for="modalDate">
          {ui.modal.dateLabel} <span class="text-brand-lavender">*</span>
        </label>
        <input
          id="modalDate"
          class="min-h-13 w-full rounded-2xl border border-brand-sage/14 bg-white/70 px-4 py-[0.85rem] text-inherit dark:bg-white/6"
          name="datePreference"
          type="text"
          placeholder={ui.modal.datePlaceholder}
          required
        />
        <p class="m-0 text-[0.9rem] text-brand-muted">
          {ui.modal.dateHint}
        </p>
      </div>

      <button class="btn-brand" type="submit">{ui.modal.submit}</button>
    </form>
  </article>
</dialog>
