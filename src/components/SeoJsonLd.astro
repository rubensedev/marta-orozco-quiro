---
import { getRelativeLocaleUrl } from "astro:i18n";
import type { SiteBundle } from "../data/site";
import { faqAnswerText } from "../data/site/faq";
import { businessInfo, sharedMeta } from "../data/site/shared";

type Props = {
  site: SiteBundle;
};

const { site } = Astro.props;
const { locale, meta, treatments, rituals, faq } = site;
const siteOrigin = Astro.site ?? new URL("https://martaorozcoquiro.netlify.app");
const homeUrl = new URL("/", siteOrigin).href;
const canonicalPageUrl = new URL(getRelativeLocaleUrl(locale), siteOrigin).href;

const businessId = new URL("/#business", siteOrigin).href;
const personId = new URL("/#person", siteOrigin).href;
const websiteId = new URL("/#website", siteOrigin).href;
const webpageId = `${canonicalPageUrl}#webpage`;
const serviceId = (id: string) => new URL(`/#service-${id}`, siteOrigin).href;
const inLanguage = locale === "es" ? "es-ES" : "en-GB";

/** Google Place ID for stable Maps identity (hasMap); NAP fields unchanged. */
const googlePlaceId = "ChIJE7KlJmBtEg0Rn-RGXchxER0";
const googlePlaceMapUrl = `https://www.google.com/maps/place/?q=place_id:${googlePlaceId}`;

const businessName = businessInfo.name[locale];
const addressLocality = businessInfo.addressLocality[locale];

const services = [
  ...treatments.map((treatment) => ({
    "@type": "Service",
    "@id": serviceId(treatment.id),
    name: treatment.title,
    description: treatment.description,
    provider: { "@id": businessId },
    offers: {
      "@type": "AggregateOffer",
      lowPrice: Math.min(...treatment.durations.map((d) => d.price)),
      highPrice: Math.max(...treatment.durations.map((d) => d.price)),
      priceCurrency: "EUR",
    },
  })),
  ...rituals.map((ritual) => ({
    "@type": "Service",
    "@id": serviceId(ritual.id),
    name: ritual.title,
    description: ritual.description,
    provider: { "@id": businessId },
    offers: {
      "@type": "Offer",
      price: ritual.price,
      priceCurrency: "EUR",
    },
  })),
];

const graph: Record<string, unknown>[] = [
  {
    "@type": "WebSite",
    "@id": websiteId,
    url: homeUrl,
    name: "Marta Orozco",
    inLanguage: ["es-ES", "en-GB"],
    publisher: { "@id": businessId },
  },
  {
    "@type": "WebPage",
    "@id": webpageId,
    url: canonicalPageUrl,
    name: meta.title,
    description: meta.description,
    inLanguage,
    isPartOf: { "@id": websiteId },
    about: { "@id": businessId },
    mainEntity: { "@id": businessId },
  },
  {
    "@type": "HealthAndBeautyBusiness",
    "@id": businessId,
    name: businessName,
    url: homeUrl,
    image: new URL(sharedMeta.ogImage, siteOrigin).href,
    telephone: `+${sharedMeta.whatsappNumber}`,
    priceRange: businessInfo.priceRange,
    address: {
      "@type": "PostalAddress",
      streetAddress: businessInfo.streetAddress,
      postalCode: businessInfo.postalCode,
      addressLocality,
      addressRegion: businessInfo.addressRegion,
      addressCountry: businessInfo.addressCountry,
    },
    geo: {
      "@type": "GeoCoordinates",
      latitude: businessInfo.geo.latitude,
      longitude: businessInfo.geo.longitude,
    },
    openingHoursSpecification: [
      {
        "@type": "OpeningHoursSpecification",
        dayOfWeek: businessInfo.openingHours.dayOfWeek,
        opens: businessInfo.openingHours.opens,
        closes: businessInfo.openingHours.closes,
      },
    ],
    hasMap: googlePlaceMapUrl,
    sameAs: [sharedMeta.instagramUrl, sharedMeta.googleReviewsUrl],
  },
  {
    "@type": "Person",
    "@id": personId,
    name: "Marta Orozco",
    jobTitle: locale === "es" ? "Quiromasajista" : "Massage Therapist",
    worksFor: { "@id": businessId },
    url: homeUrl,
  },
  ...services,
];

if (faq.items.length > 0) {
  graph.push({
    "@type": "FAQPage",
    "@id": `${canonicalPageUrl}#faq`,
    isPartOf: { "@id": webpageId },
    mainEntity: faq.items.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: faqAnswerText(item.answer),
      },
    })),
  });
}

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": graph,
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
