---
import { siteMeta } from "../data/site";
---

<section id="contacto" class="mx-auto w-[min(1120px,calc(100%-2rem))] py-20 md:py-24">
  <div class="grid gap-8 lg:grid-cols-12 lg:items-center">
    <article
      class="rounded-[2rem] bg-white/56 p-8 shadow-soft md:p-10 lg:col-span-5 dark:bg-white/6"
    >
      <p
        class="section-eyebrow m-0 mb-4 inline-flex items-center gap-3 text-xs font-semibold tracking-[0.24em] text-brand-sage uppercase"
      >
        Citas y horario
      </p>
      <h2 class="m-0 font-serif text-[clamp(2.25rem,4vw,3.5rem)] leading-[1.1] font-light">
        Ubicación y contacto
      </h2>
      <p class="mt-5 mb-0 flex items-start gap-3">
        <i class="fa-regular fa-clock" aria-hidden="true"></i>
        <span>Jueves de 15:00 a 20:00</span>
      </p>
      <p class="mt-4 mb-0 text-[0.9rem] italic">
        *Citas bajo reserva previa para garantizar tu atención personalizada.
      </p>
      <p class="mt-5 mb-0 flex items-start gap-3">
        <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
        <span>C. Esperanza Elena Caro, 2, 1°A4 / 41002 Sevilla</span>
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <button class="btn-brand" type="button" data-open-booking>Reservar Ahora</button>
        <a
          class="btn-secondary"
          href={`https://wa.me/${siteMeta.whatsappNumber}?text=${encodeURIComponent(siteMeta.whatsappInquiry)}`}
        >
          WhatsApp
        </a>
      </div>

      <ul class="mt-8 mb-0 flex list-none flex-wrap items-center gap-6 p-0">
        <li>
          <a
            class="flex items-start gap-3"
            href={siteMeta.instagramUrl}
            target="_blank"
            rel="noreferrer"
          >
            <i class="fa-brands fa-instagram" aria-hidden="true"></i>
            <span>Instagram</span>
          </a>
        </li>
        <li>
          <a
            class="flex items-start gap-3"
            href={`https://wa.me/${siteMeta.whatsappNumber}?text=${encodeURIComponent(siteMeta.whatsappInquiry)}`}
            data-whatsapp-direct
          >
            <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
            <span>{siteMeta.whatsappDisplay}</span>
          </a>
        </li>
      </ul>
    </article>

    <div
      class="rounded-[2rem] bg-white/56 p-4 shadow-soft md:p-10 lg:col-span-7 dark:bg-white/6"
    >
      <img
        class="aspect-[16/10] h-full w-full rounded-[1.5rem] object-cover"
        src="/assets/images/contact.webp"
        alt="Espacio donde se realizan las sesiones."
        width="960"
        height="720"
        loading="lazy"
      />
      <iframe
        class="contact__map mt-4 h-72 w-full rounded-[1.5rem] border-0"
        title="Mapa de ubicación de Marta Orozco"
        src={siteMeta.mapEmbedUrl}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </div>
</section>
