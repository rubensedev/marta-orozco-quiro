---
import { Image } from "astro:assets";
import heroBg from "../assets/images/hero.webp";
import type { SiteBundle } from "../data/site";
import HeroPortrait from "./HeroPortrait.astro";

type Props = {
  site: SiteBundle;
};

const { site } = Astro.props;
const { hero } = site;
---

<div class="hero-section">
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 overflow-hidden">
      <Image
        class="absolute inset-0 h-full w-full object-cover"
        src={heroBg}
        alt={hero.backgroundImageAlt}
        width={1536}
        height={1024}
        widths={[640, 960, 1280, 1536]}
        sizes="100vw"
        fetchpriority="high"
        loading="eager"
        quality={85}
      />
      <div class="hero__overlay absolute inset-0" aria-hidden="true"></div>
    </div>

    <div
      class="hero-inner relative z-1 mx-auto flex min-h-[65vh] w-[min(1120px,calc(100%-2rem))] flex-col pt-28 lg:min-h-0 lg:grid lg:grid-cols-[minmax(0,1fr)_min(36%,22rem)] lg:items-start lg:gap-8 lg:pt-28 lg:pb-12 xl:grid-cols-[minmax(0,1fr)_min(34%,24rem)]"
    >
      <div class="hero-content max-w-3xl md:px-6 md:pt-8 lg:px-8 lg:pt-10">
        <h1
          class="hero-reveal hero-reveal--1 m-0 font-serif text-[clamp(2.5rem,7vw,5.25rem)] leading-tight font-normal lg:text-[clamp(2.25rem,3.5vw,3.75rem)]"
        >
          {hero.title}
        </h1>
        {
          hero.subtitle && (
            <p class="hero-reveal hero-reveal--1 mt-3 mb-0 text-[1.05rem] font-medium tracking-[0.04em] text-brand-lavender uppercase dark:text-brand-lavender-bright lg:text-[0.95rem]">
              {hero.subtitle}
            </p>
          )
        }
        <p
          class="hero-reveal hero-reveal--2 mt-6 mb-0 max-w-2xl text-[1.15rem] leading-[1.45] text-brand-muted lg:mt-4 lg:text-[1rem]"
        >
          {hero.description}
        </p>

        <div class="hero-reveal hero-reveal--3 mt-8 flex flex-wrap items-center gap-4">
          <button class="btn-brand" type="button" data-open-booking>
            {hero.primaryCta}
          </button>
          <a class="btn-secondary" href={hero.secondaryCta.href}>
            {hero.secondaryCta.label}
          </a>
        </div>
      </div>

      <HeroPortrait class="hero-reveal hero-reveal--4" portraitAlt={hero.portraitAlt} />
    </div>
  </section>
</div>
