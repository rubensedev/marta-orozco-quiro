---
import HeroPortrait from "./HeroPortrait.astro";
import { heroContent } from "../data/site";
---

<div class="hero-section">
  <section class="relative min-h-[65vh] lg:min-h-[82vh] lg:overflow-hidden">
    <div class="absolute inset-0 overflow-hidden">
      <img
        class="absolute inset-0 h-full w-full object-cover"
        src="/assets/images/hero.webp"
        alt={heroContent.backgroundImageAlt}
        width="1536"
        height="1024"
        fetchpriority="high"
      />
      <div class="hero__overlay absolute inset-0" aria-hidden="true"></div>
    </div>

    <div
      class="hero-inner relative z-1 mx-auto flex min-h-[65vh] w-[min(1120px,calc(100%-2rem))] flex-col pt-20 lg:min-h-[82vh] lg:grid lg:grid-cols-[minmax(0,1fr)_min(46%,32rem)] lg:items-center lg:gap-10 lg:pb-8 xl:grid-cols-[minmax(0,1fr)_min(42%,34rem)]"
    >
      <div class="hero-content max-w-3xl md:px-6 md:pt-8 lg:px-10 lg:pt-12">
        <h1
          class="m-0 font-serif text-[clamp(2.5rem,7vw,5.25rem)] leading-tight font-normal"
        >
          {heroContent.title}
        </h1>
        <p
          class="mt-6 mb-0 max-w-2xl text-[1.15rem] leading-[1.45] text-brand-muted"
        >
          {heroContent.description}
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <button class="btn-brand" type="button" data-open-booking>
            {heroContent.primaryCta}
          </button>
          <a class="btn-secondary" href={heroContent.secondaryCta.href}>
            {heroContent.secondaryCta.label}
          </a>
        </div>
      </div>

      <HeroPortrait class="hero-portrait--mobile lg:hidden" />
      <HeroPortrait class="hidden lg:block" priority />
    </div>
  </section>
</div>
