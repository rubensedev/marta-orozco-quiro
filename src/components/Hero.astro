---
import { heroContent } from "../data/site";
import HeroPortrait from "./HeroPortrait.astro";
---

<div class="hero-section">
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 overflow-hidden">
      <img
        class="absolute inset-0 h-full w-full object-cover"
        src="/assets/images/hero.webp"
        alt={heroContent.backgroundImageAlt}
        width="1536"
        height="1024"
        fetchpriority="high"
      />
      <div class="hero__overlay absolute inset-0" aria-hidden="true"></div>
    </div>

    <div
      class="hero-inner relative z-1 mx-auto flex min-h-[65vh] w-[min(1120px,calc(100%-2rem))] flex-col pt-24 lg:min-h-0 lg:grid lg:grid-cols-[minmax(0,1fr)_min(36%,22rem)] lg:items-start lg:gap-8 lg:pt-28 lg:pb-12 xl:grid-cols-[minmax(0,1fr)_min(34%,24rem)]"
    >
      <div class="hero-content max-w-3xl md:px-6 md:pt-8 lg:px-8 lg:pt-10">
        <h1
          class="hero-reveal hero-reveal--1 m-0 font-serif text-[clamp(2.5rem,7vw,5.25rem)] leading-tight font-normal lg:text-[clamp(2.25rem,3.5vw,3.75rem)]"
        >
          {heroContent.title}
        </h1>
        <p
          class="hero-reveal hero-reveal--2 mt-6 mb-0 max-w-2xl text-[1.15rem] leading-[1.45] text-brand-muted lg:mt-4 lg:text-[1rem]"
        >
          {heroContent.description}
        </p>

        <div class="hero-reveal hero-reveal--3 mt-8 flex flex-wrap items-center gap-4">
          <button class="btn-brand" type="button" data-open-booking>
            {heroContent.primaryCta}
          </button>
          <a class="btn-secondary" href={heroContent.secondaryCta.href}>
            {heroContent.secondaryCta.label}
          </a>
        </div>
      </div>

      <HeroPortrait class="hero-portrait--mobile hero-reveal hero-reveal--4 lg:hidden" />
      <HeroPortrait class="hero-reveal hero-reveal--4 hidden lg:block" priority />
    </div>
  </section>
</div>
