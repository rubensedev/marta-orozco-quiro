---
import { getRelativeLocaleUrl } from "astro:i18n";
import { LOCALE_KEY, type Locale, type SiteBundle } from "../data/site";

type Props = {
  site: SiteBundle;
};

const { site } = Astro.props;
const { navItems, ui, sectionIds, locale } = site;

const themeOptions = [
  { value: "light", label: ui.theme.light, icon: "fa-solid fa-sun text-amber-500" },
  { value: "dark", label: ui.theme.dark, icon: "fa-solid fa-moon text-indigo-400" },
  {
    value: "system",
    label: ui.theme.system,
    icon: "fa-solid fa-circle-half-stroke text-slate-600 dark:text-amber-300",
  },
];

const localeOptions: { value: Locale; label: string; code: string }[] = [
  { value: "es", label: ui.lang.es, code: "ES" },
  { value: "en", label: ui.lang.en, code: "EN" },
];

const themeBtnClass =
  "theme-menu-btn inline-flex h-12 w-[75%] text-2xl shrink-0 cursor-pointer items-center justify-center whitespace-nowrap rounded-full text-inherit transition-all duration-200";
const themeDrawerBtnClass =
  "inline-flex size-12 text-2xl shrink-0 cursor-pointer items-center justify-center whitespace-nowrap rounded-full bg-transparent text-inherit transition-all duration-200";
const langBtnClass =
  "inline-flex h-12 shrink-0 cursor-pointer items-center justify-center gap-1.5 whitespace-nowrap rounded-full px-2.5 text-inherit transition-all duration-200";
const langDrawerBtnClass =
  "inline-flex h-12 shrink-0 cursor-pointer items-center justify-center gap-1.5 whitespace-nowrap rounded-full bg-transparent px-2.5 text-inherit transition-all duration-200";
const themeMenuClass =
  "absolute top-full z-50 mt-2 flex w-max min-w-52 flex-col rounded-[1.5rem] bg-white p-1.5 text-brand-text-dark shadow-soft dark:bg-brand-card-dark dark:text-brand-text-light";
const themeOptionClass =
  "group flex w-full cursor-pointer items-center gap-3 rounded-2xl border-0 bg-transparent px-3 py-2.5 text-left text-sm text-brand-text-dark hover:bg-black/5 aria-checked:bg-black/5 dark:text-brand-text-light dark:hover:bg-white/8 dark:aria-checked:bg-white/10";

const currentCode = locale === "en" ? "EN" : "ES";
const esHrefBase = getRelativeLocaleUrl("es");
const enHrefBase = getRelativeLocaleUrl("en");
---

<div
  data-header-sentinel
  class="pointer-events-none h-px w-full"
  aria-hidden="true"
>
</div>
<header
  class="group fixed inset-x-0 top-0 z-40 border-b border-transparent bg-transparent text-brand-text-light transition-[background-color,border-color,backdrop-filter,color] duration-300 ease-out data-scrolled:border-brand-sage/8 data-scrolled:bg-brand-bg/90 data-scrolled:text-brand-text-dark data-scrolled:backdrop-blur-[18px] dark:text-brand-text-light dark:data-scrolled:border-white/8 dark:data-scrolled:bg-brand-bg-dark/90 dark:data-scrolled:text-brand-text-light"
>
  <div
    class="mx-auto flex w-[min(1120px,calc(100%-2rem))] items-center justify-between gap-4 py-2 lg:py-4"
  >
    <a href={`#${sectionIds.home}`} aria-label={ui.nav.homeAria}>
      <img
        class="site-logo h-10 w-auto brightness-0 invert transition-[filter] duration-300 ease-out group-data-scrolled:not-dark:brightness-100 group-data-scrolled:not-dark:invert-0"
        src="/assets/images/logo.svg"
        alt={site.footer.logoAlt}
      />
    </a>

    <nav class="hidden lg:block" aria-label={ui.nav.primaryAria}>
      <ul class="m-0 flex list-none items-center gap-8 p-0">
        {
          navItems.map((item) => (
            <li>
              <a
                class="text-[0.95rem] font-medium transition-colors duration-200 hover:text-brand-lavender"
                href={item.href}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex shrink-0 flex-nowrap items-center gap-3">
      <div
        class="relative hidden shrink-0 items-center justify-center md:inline-flex"
        data-lang-widget
      >
        <button
          id="langMenuBtn"
          class={langBtnClass}
          type="button"
          data-lang-menu-btn
          aria-label={ui.lang.ariaLabel}
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="langMenu"
        >
          <i class="fa-solid fa-language text-xl" aria-hidden="true"></i>
          <span class="text-sm font-semibold tracking-wide" data-lang-code>
            {currentCode}
          </span>
          <i class="fa-solid fa-chevron-down text-[10px]" aria-hidden="true"></i>
        </button>

        <div
          id="langMenu"
          class={`${themeMenuClass} right-0`}
          data-lang-menu
          role="menu"
          hidden
        >
          {
            localeOptions.map((option) => (
              <button
                class={themeOptionClass}
                type="button"
                role="menuitemradio"
                data-lang-option={option.value}
                data-lang-href={option.value === "en" ? enHrefBase : esHrefBase}
                aria-checked={option.value === locale ? "true" : "false"}
              >
                <span class="flex-1 whitespace-nowrap">
                  {option.code} — {option.label}
                </span>
                <i
                  class="fa-solid fa-check text-sm opacity-0 group-aria-checked:opacity-100"
                  aria-hidden="true"
                />
              </button>
            ))
          }
        </div>
      </div>

      <div
        class="relative hidden size-12 shrink-0 items-center justify-center md:inline-flex"
        data-theme-widget
      >
        <button
          id="themeMenuBtn"
          class={themeBtnClass}
          type="button"
          data-theme-menu-btn
          aria-label={ui.theme.ariaLabel}
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="themeMenu"
        >
          <i
            id="themeMenuIcon"
            class="fa-solid fa-circle-half-stroke"
            data-theme-menu-icon
            aria-hidden="true"></i>
        </button>

        <div
          id="themeMenu"
          class={`${themeMenuClass} right-0`}
          data-theme-menu
          role="menu"
          hidden
        >
          {
            themeOptions.map((option) => (
              <button
                class={themeOptionClass}
                type="button"
                role="menuitemradio"
                data-theme-option={option.value}
              >
                <i class:list={["fa-fw", option.icon]} aria-hidden="true" />
                <span class="flex-1 whitespace-nowrap">{option.label}</span>
                <i
                  class="fa-solid fa-check text-sm opacity-0 group-aria-checked:opacity-100"
                  aria-hidden="true"
                />
              </button>
            ))
          }
        </div>
      </div>

      <button
        class="btn-brand hidden md:inline-flex"
        type="button"
        data-open-booking
      >
        {ui.reserveNow}
        <i class="fa-solid fa-chevron-right text-[10px]"></i>
      </button>

      <button
        id="mobileMenuBtn"
        class="inline-flex size-16 shrink-0 cursor-pointer items-center justify-center whitespace-nowrap bg-transparent text-3xl lg:hidden"
        type="button"
        aria-controls="mobileMenu"
        aria-expanded="false"
        aria-label={ui.nav.openMenu}
      >
        <i data-mobile-menu-icon class="fa-solid fa-bars" aria-hidden="true"
        ></i>
      </button>
    </div>
  </div>
</header>

<div
  data-mobile-nav-backdrop
  class="fixed inset-0 z-50 bg-black/40 opacity-0 pointer-events-none transition-opacity duration-200 lg:hidden data-open:pointer-events-auto data-open:opacity-100"
  aria-hidden="true"
>
</div>

<div
  id="mobileMenu"
  class="pointer-events-none fixed inset-y-0 right-0 z-60 w-[min(20rem,90vw)] translate-x-full bg-white px-6 pt-3 pb-8 shadow-soft transition-transform duration-200 lg:hidden data-open:pointer-events-auto data-open:translate-x-0 dark:bg-brand-card-dark"
  aria-hidden="true"
  inert
>
  <button
    class="ml-auto mt-1 mr-3 flex size-12 shrink-0 cursor-pointer items-center justify-center bg-transparent text-3xl"
    type="button"
    data-close-mobile-nav
    aria-label={ui.nav.closeMenu}
  >
    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
  </button>
  <nav
    class="flex flex-col gap-4 border-t border-brand-sage/8 pt-4 dark:border-white/8"
    aria-label={ui.nav.mobileAria}
  >
    {
      navItems.map((item) => (
        <a
          class="text-[0.95rem] font-medium transition-colors duration-200 hover:text-brand-lavender"
          href={item.href}
          data-close-mobile-nav
        >
          {item.label}
        </a>
      ))
    }
    <button class="btn-brand" type="button" data-open-booking-close-nav>
      {ui.reserveNow}
    </button>
    <div
      class="flex items-center gap-3 border-t border-brand-sage/8 pt-4 dark:border-white/8"
    >
      <div class="relative" data-lang-widget>
        <button
          id="langMenuBtnDrawer"
          class={langDrawerBtnClass}
          type="button"
          data-lang-menu-btn
          aria-label={ui.lang.ariaLabel}
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="langMenuDrawer"
        >
          <i class="fa-solid fa-language text-xl" aria-hidden="true"></i>
          <span class="text-sm font-semibold tracking-wide" data-lang-code>
            {currentCode}
          </span>
          <i class="fa-solid fa-chevron-down text-[10px]" aria-hidden="true"></i>
        </button>

        <div
          id="langMenuDrawer"
          class={`${themeMenuClass} left-0`}
          data-lang-menu
          role="menu"
          hidden
        >
          {
            localeOptions.map((option) => (
              <button
                class={themeOptionClass}
                type="button"
                role="menuitemradio"
                data-lang-option={option.value}
                data-lang-href={option.value === "en" ? enHrefBase : esHrefBase}
                aria-checked={option.value === locale ? "true" : "false"}
              >
                <span class="flex-1 whitespace-nowrap">
                  {option.code} — {option.label}
                </span>
                <i
                  class="fa-solid fa-check text-sm opacity-0 group-aria-checked:opacity-100"
                  aria-hidden="true"
                />
              </button>
            ))
          }
        </div>
      </div>

      <div class="relative" data-theme-widget>
        <button
          id="themeMenuBtnDrawer"
          class={themeDrawerBtnClass}
          type="button"
          data-theme-menu-btn
          aria-label={ui.theme.ariaLabel}
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="themeMenuDrawer"
        >
          <i
            id="themeMenuIconDrawer"
            class="fa-solid fa-circle-half-stroke"
            data-theme-menu-icon
            aria-hidden="true"></i>
        </button>

        <div
          id="themeMenuDrawer"
          class={`${themeMenuClass} left-0`}
          data-theme-menu
          role="menu"
          hidden
        >
          {
            themeOptions.map((option) => (
              <button
                class={themeOptionClass}
                type="button"
                role="menuitemradio"
                data-theme-option={option.value}
              >
                <i class:list={["fa-fw", option.icon]} aria-hidden="true" />
                <span class="flex-1 whitespace-nowrap">{option.label}</span>
                <i
                  class="fa-solid fa-check text-sm opacity-0 group-aria-checked:opacity-100"
                  aria-hidden="true"
                />
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </nav>
</div>

<script
  define:vars={{
    LOCALE_KEY,
    HASH_ES_TO_EN: {
      inicio: "home",
      "sobre-mi": "about",
      masajes: "massages",
      bonos: "packages",
      contacto: "contact",
    },
    HASH_EN_TO_ES: {
      home: "inicio",
      about: "sobre-mi",
      massages: "masajes",
      packages: "bonos",
      contact: "contacto",
    },
  }}
>
  function mapHash(raw, targetLocale) {
    if (!raw) return "";
    if (targetLocale === "en") {
      return HASH_ES_TO_EN[raw] || (HASH_EN_TO_ES[raw] ? raw : raw);
    }
    return HASH_EN_TO_ES[raw] || (HASH_ES_TO_EN[raw] ? raw : raw);
  }

  function closeAllLangMenus() {
    document.querySelectorAll("[data-lang-menu]").forEach((menu) => {
      menu.hidden = true;
    });
    document.querySelectorAll("[data-lang-menu-btn]").forEach((button) => {
      button.setAttribute("aria-expanded", "false");
    });
  }

  function menuForLangButton(button) {
    return document.getElementById(button.getAttribute("aria-controls"));
  }

  function toggleLangMenu(button, forceOpen) {
    const menu = menuForLangButton(button);
    if (!menu) return;
    const open = forceOpen ?? menu.hidden;
    closeAllLangMenus();
    if (open) {
      menu.hidden = false;
      button.setAttribute("aria-expanded", "true");
    }
  }

  document.querySelectorAll("[data-lang-menu-btn]").forEach((button) => {
    button.addEventListener("click", (event) => {
      event.stopPropagation();
      toggleLangMenu(button);
    });
  });

  document.querySelectorAll("[data-lang-option]").forEach((button) => {
    button.addEventListener("click", () => {
      const nextLocale = button.dataset.langOption;
      const base = button.dataset.langHref || (nextLocale === "en" ? "/en/" : "/");
      localStorage.setItem(LOCALE_KEY, nextLocale);
      const raw = (window.location.hash || "").replace(/^#/, "");
      const mapped = mapHash(raw, nextLocale);
      const nextHash = mapped ? `#${mapped}` : "";
      window.location.assign(`${base}${nextHash}`);
    });
  });

  document.addEventListener("click", (event) => {
    if (!event.target.closest("[data-lang-widget]")) {
      closeAllLangMenus();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeAllLangMenus();
  });

  window.__closeAllLangMenus = closeAllLangMenus;
</script>
