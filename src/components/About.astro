---
import { aboutContent } from "../data/site";
---

<section id="sobre-mi" class="mx-auto w-[min(1120px,calc(100%-2rem))] py-20 md:py-24">
  <div class="grid gap-8 lg:grid-cols-12 lg:items-center">
    <article
      class="rounded-[2rem] bg-brand-lavender-light p-8 shadow-soft md:p-10 lg:col-span-7 dark:bg-brand-lavender-dark/50"
    >
      <p
        class="section-eyebrow m-0 mb-4 inline-flex items-center gap-3 text-xs font-semibold tracking-[0.24em] text-brand-lavender uppercase"
      >
        {aboutContent.eyebrow}
      </p>
      <h2 class="m-0 font-serif text-[clamp(2.25rem,4vw,3.5rem)] leading-[1.1] font-light">
        {aboutContent.title}
      </h2>
      <p class="mt-3 mb-0 text-lg font-medium text-brand-muted">{aboutContent.subtitle}</p>
      {
        aboutContent.paragraphs.map((paragraph) => (
          <p class="mt-5 mb-0 leading-[1.8]">{paragraph}</p>
        ))
      }
    </article>

    <figure class="m-0 lg:col-span-5">
      <img
        class="aspect-[4/5] h-full w-full rounded-[3rem] border-4 border-white object-cover dark:border-stone-800"
        src="/assets/images/about.webp"
        alt="Retrato de Marta Orozco."
        width="720"
        height="900"
        loading="lazy"
      />
    </figure>
  </div>
</section>
