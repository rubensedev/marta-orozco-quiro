---
import type { SiteBundle } from "../data/site";
import AboutStats from "./AboutStats.astro";
import SectionHeading from "./SectionHeading.astro";

type Props = {
  site: SiteBundle;
};

const { site } = Astro.props;
const { about, sectionIds } = site;
---

<section
  id={sectionIds.about}
  class="mx-auto w-[min(1120px,calc(100%-2rem))] py-[clamp(3rem,8vh,6rem)] md:px-6 lg:px-8"
  data-about-section
>
  <SectionHeading title={about.heading} />

  <article
    class="about-reveal about-reveal--1 isolate rounded-4xl border border-glass-edge bg-glass-panel-lavender p-8 shadow-glass backdrop-blur-glass-panel md:p-10 dark:shadow-[var(--shadow-glass-dark)]"
  >
    <h3
      class="about-reveal about-reveal--3 m-0 font-serif text-[clamp(1.75rem,3vw,2.5rem)] leading-[1.1] font-normal text-brand-lavender dark:text-brand-lavender-bright"
    >
      {about.title}
    </h3>
    <p class="about-reveal about-reveal--4 mt-3 mb-0 text-lg font-medium text-brand-muted">
      {about.subtitle}
    </p>
    {
      about.paragraphs.map((paragraph: string, i: number) => (
        <p class={`about-reveal about-reveal--${i + 5} mt-5 mb-0 leading-[1.8]`}>{paragraph}</p>
      ))
    }

    <div class="about-reveal about-reveal--8 about-techniques mt-8">
      <p class="about-techniques__label m-0">{about.techniquesHeading}</p>
      <ul class="about-techniques__list m-0 mt-3 flex list-none flex-wrap gap-2 p-0" role="list">
        {
          about.techniques.map((technique: string) => (
            <li class="about-techniques__item">{technique}</li>
          ))
        }
      </ul>
    </div>
  </article>
  <AboutStats site={site} />
</section>

<style>
  .about-reveal {
    transition:
      opacity 0.9s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      transform 0.9s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(html.js) .about-reveal:not(.is-visible) {
    opacity: 0;
    transform: translateY(14px);
  }

  .about-reveal--1  { transition-delay: 0s; }
  .about-reveal--3  { transition-delay: 0.2s; }
  .about-reveal--4  { transition-delay: 0.32s; }
  .about-reveal--5  { transition-delay: 0.44s; }
  .about-reveal--6  { transition-delay: 0.54s; }
  .about-reveal--7  { transition-delay: 0.64s; }
  .about-reveal--8  { transition-delay: 0.74s; }

  .about-techniques__label {
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-brand-lavender);
  }

  :global(.dark) .about-techniques__label {
    color: var(--color-brand-lavender-bright);
  }

  .about-techniques__item {
    padding: 0.4rem 0.85rem;
    border: 1px solid color-mix(in oklch, var(--color-brand-lavender) 22%, transparent);
    border-radius: 0.55rem;
    background: color-mix(in oklch, white 55%, transparent);
    color: var(--color-brand-text-dark);
    font-size: 0.875rem;
    letter-spacing: 0.01em;
    line-height: 1.3;
  }

  :global(.dark) .about-techniques__item {
    border-color: color-mix(in oklch, var(--color-brand-lavender-bright) 28%, transparent);
    background: color-mix(in oklch, var(--color-brand-card-dark) 55%, transparent);
    color: var(--color-brand-text-light);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .about-reveal:not(.is-visible),
    .about-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12 }
  );

  document.querySelectorAll("[data-about-section] .about-reveal").forEach((el) => {
    observer.observe(el);
  });
</script>
