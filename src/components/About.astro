---
import { aboutContent } from "../data/site";
import AboutStats from "./AboutStats.astro";
import SectionHeading from "./SectionHeading.astro";
---

<section
  id="sobre-mi"
  class="mx-auto w-[min(1120px,calc(100%-2rem))] py-[clamp(3rem,8vh,6rem)] md:px-6 lg:px-8"
>
  <SectionHeading title={aboutContent.heading} />

  <article
    class="about-reveal about-reveal--1 rounded-4xl bg-brand-lavender-light p-8 shadow-soft md:p-10 dark:bg-brand-lavender-dark/50"
  >
    <h3
      class="about-reveal about-reveal--3 m-0 font-serif text-[clamp(1.75rem,3vw,2.5rem)] leading-[1.1] font-normal"
    >
      {aboutContent.title}
    </h3>
    <p class="about-reveal about-reveal--4 mt-3 mb-0 text-lg font-medium text-brand-muted">
      {aboutContent.subtitle}
    </p>
    {
      aboutContent.paragraphs.map((paragraph, i) => (
        <p class={`about-reveal about-reveal--${i + 5} mt-5 mb-0 leading-[1.8]`}>{paragraph}</p>
      ))
    }
  </article>
  <AboutStats />
</section>

<style>
  .about-reveal {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.9s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      transform 0.9s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .about-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .about-reveal--1  { transition-delay: 0s; }
  .about-reveal--3  { transition-delay: 0.2s; }
  .about-reveal--4  { transition-delay: 0.32s; }
  .about-reveal--5  { transition-delay: 0.44s; }
  .about-reveal--6  { transition-delay: 0.54s; }

  @media (prefers-reduced-motion: reduce) {
    .about-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12 }
  );

  document.querySelectorAll("#sobre-mi .about-reveal").forEach((el) => {
    observer.observe(el);
  });
</script>
