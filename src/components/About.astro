---
import { aboutContent } from "../data/site";
---

<section
  id="sobre-mi"
  class="mx-auto w-[min(1120px,calc(100%-2rem))] py-[clamp(3rem,8vh,6rem)] md:py-24"
>
  <article
    class="rounded-4xl bg-brand-lavender-light p-8 shadow-soft md:p-10 dark:bg-brand-lavender-dark/50"
  >
    <p class="m-0 mb-4 inline-flex items-center gap-3 text-xs font-semibold tracking-[0.24em] text-brand-lavender uppercase">
      {aboutContent.eyebrow}
    </p>
    <h2
      class="m-0 font-serif text-[clamp(2.25rem,4vw,3.5rem)] leading-[1.1] font-light"
    >
      {aboutContent.title}
    </h2>
    <p class="mt-3 mb-0 text-lg font-medium text-brand-muted">
      {aboutContent.subtitle}
    </p>
    {
      aboutContent.paragraphs.map((paragraph) => (
        <p class="mt-5 mb-0 leading-[1.8]">{paragraph}</p>
      ))
    }
  </article>
</section>
