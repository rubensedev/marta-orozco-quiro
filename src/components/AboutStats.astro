---
import { Image } from "astro:assets";
import heroBg from "../assets/images/hero.webp";
import type { SiteBundle } from "../data/site";

type Props = {
  site: SiteBundle;
};

const { site } = Astro.props;
const { aboutStats } = site;
---

<section
  id="about-stats"
  class="mx-auto w-[min(1120px,calc(100%-2rem))] py-[clamp(3rem,8vh,6rem)] md:px-6 lg:px-8"
>
  <div class="about-reveal about-reveal--1 relative overflow-hidden rounded-4xl shadow-soft">
    <Image
      src={heroBg}
      alt=""
      class="absolute inset-0 h-full w-full object-cover"
      aria-hidden="true"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-brand-sage/75"></div>

    <div class="relative z-10 flex divide-x divide-white/25">
      {
        aboutStats.map((stat, i) => (
          <div class={`about-reveal about-reveal--${i + 2} flex flex-1 flex-col items-center gap-2 px-8 py-14 text-center text-white`}>
            <span class="font-serif text-[clamp(3rem,6vw,4.5rem)] leading-none font-light">
              {stat.value}
            </span>
            <span class="text-sm font-semibold tracking-[0.18em] uppercase opacity-80">
              {stat.label}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .about-reveal {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.9s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      transform 0.9s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .about-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .about-reveal--1 { transition-delay: 0s; }
  .about-reveal--2 { transition-delay: 0.15s; }
  .about-reveal--3 { transition-delay: 0.28s; }

  @media (prefers-reduced-motion: reduce) {
    .about-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12 }
  );

  document.querySelectorAll("#about-stats .about-reveal").forEach((el) => {
    observer.observe(el);
  });
</script>
