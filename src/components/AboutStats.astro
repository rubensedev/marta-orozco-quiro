---
import { Image } from "astro:assets";
import heroBg from "../assets/images/hero.webp";
import type { SiteBundle } from "../data/site";

type Props = {
  site: SiteBundle;
};

const { site } = Astro.props;
const { aboutStats } = site;

function parseStatValue(value: string) {
  const match = value.match(/^([^0-9]*)(\d+)(.*)$/);
  if (!match) {
    return { prefix: "", number: 0, suffix: "", raw: value };
  }
  return {
    prefix: match[1] ?? "",
    number: Number(match[2]),
    suffix: match[3] ?? "",
    raw: value,
  };
}

const staggerDelaysMs = [150, 280] as const;
---

<section
  id="about-stats"
  class="mx-auto w-[min(1120px,calc(100%-2rem))] py-[clamp(3rem,8vh,6rem)] md:px-6 lg:px-8"
>
  <div class="about-reveal about-reveal--1 relative overflow-hidden rounded-4xl shadow-soft">
    <Image
      src={heroBg}
      alt=""
      class="absolute inset-0 h-full w-full object-cover"
      aria-hidden="true"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-brand-sage/75"></div>

    <div class="relative z-10 flex flex-col divide-y divide-white/25 md:flex-row md:divide-x md:divide-y-0">
      {
        aboutStats.map((stat, i) => {
          const parsed = parseStatValue(stat.value);
          return (
            <div
              class={`about-reveal about-reveal--${i + 2} flex min-w-0 flex-1 flex-col items-center gap-2 px-5 py-10 text-center text-white sm:px-6 md:px-8 md:py-14`}
            >
              <span
                class="stat-value font-serif text-[clamp(2.25rem,8vw,4.5rem)] leading-none font-light tabular-nums"
                data-count-to={String(parsed.number)}
                data-count-delay={String(staggerDelaysMs[i] ?? 0)}
                aria-label={stat.value}
              >
                <span aria-hidden="true">
                  {parsed.prefix}
                  <span class="stat-value__number">0</span>
                  {parsed.suffix}
                </span>
              </span>
              <span class="max-w-full text-balance text-xs font-semibold tracking-[0.12em] uppercase opacity-80 sm:text-sm sm:tracking-[0.18em]">
                {stat.label}
              </span>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .about-reveal {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.9s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      transform 0.9s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .about-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .about-reveal--1 { transition-delay: 0s; }
  .about-reveal--2 { transition-delay: 0.15s; }
  .about-reveal--3 { transition-delay: 0.28s; }

  @media (prefers-reduced-motion: reduce) {
    .about-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const COUNT_DURATION_MS = 1200;

  function prefersReducedMotion() {
    return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  }

  function easeOutCubic(t: number): number {
    return 1 - Math.pow(1 - t, 3);
  }

  function setStatNumber(el: HTMLElement, value: number): void {
    const numberEl = el.querySelector(".stat-value__number");
    if (numberEl) numberEl.textContent = String(value);
  }

  function animateCount(el: HTMLElement): void {
    const target = Number(el.dataset.countTo || "0");
    const delay = Number(el.dataset.countDelay || "0");

    const start = () => {
      if (prefersReducedMotion() || target <= 0) {
        setStatNumber(el, target);
        return;
      }

      const startedAt = performance.now();

      const tick = (now: number) => {
        const progress = Math.min(1, (now - startedAt) / COUNT_DURATION_MS);
        setStatNumber(el, Math.round(easeOutCubic(progress) * target));
        if (progress < 1) requestAnimationFrame(tick);
      };

      requestAnimationFrame(tick);
    };

    if (delay > 0) {
      window.setTimeout(start, delay);
    } else {
      start();
    }
  }

  function startStatCount(statValue: HTMLElement | null): void {
    if (!statValue || statValue.dataset.countStarted) return;
    statValue.dataset.countStarted = "true";
    animateCount(statValue);
  }

  if (prefersReducedMotion()) {
    document
      .querySelectorAll<HTMLElement>("#about-stats .stat-value")
      .forEach((el) => {
        setStatNumber(el, Number(el.dataset.countTo || "0"));
        el.dataset.countStarted = "true";
      });
  }

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;

        entry.target.classList.add("is-visible");
        const statValue = entry.target.querySelector(".stat-value");
        startStatCount(statValue instanceof HTMLElement ? statValue : null);
        observer.unobserve(entry.target);
      });
    },
    { threshold: 0.12 },
  );

  document
    .querySelectorAll<HTMLElement>("#about-stats .about-reveal")
    .forEach((el) => {
      observer.observe(el);
    });
</script>
