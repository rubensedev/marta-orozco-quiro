---
import type { SiteBundle } from "../data/site";

type Props = {
  site: SiteBundle;
};

const { site } = Astro.props;
const { locale, meta, ui, footer } = site;
const { notFound } = ui;
const massagesHref = locale === "en" ? "/en#massages" : "/#masajes";
const whatsappHref = `https://wa.me/${meta.whatsappNumber}?text=${encodeURIComponent(meta.whatsappInquiry)}`;
---

<main
  class="relative isolate flex min-h-[100svh] items-center justify-center overflow-hidden px-4 py-16"
  data-relax-flow-root
>
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,color-mix(in_srgb,var(--color-brand-sage)_18%,transparent),transparent_55%),linear-gradient(180deg,var(--color-brand-bg),color-mix(in_srgb,var(--color-brand-sage)_8%,var(--color-brand-bg)))] dark:bg-[radial-gradient(ellipse_at_top,color-mix(in_srgb,var(--color-brand-sage-bright)_10%,transparent),transparent_58%),linear-gradient(180deg,var(--color-brand-bg-dark),color-mix(in_srgb,var(--color-brand-sage-dark)_45%,var(--color-brand-bg-dark)))]"
    aria-hidden="true"
  >
  </div>

  <canvas
    class="pointer-events-none absolute inset-0 h-full w-full"
    data-relax-flow-canvas
    aria-hidden="true"
  ></canvas>

  <article
    class="relative z-10 w-[min(36rem,100%)] rounded-[2rem] border border-glass-edge bg-glass-surface p-8 text-center shadow-glass backdrop-blur-glass-panel md:p-10 dark:shadow-[var(--shadow-glass-dark)]"
  >
    <img
      class="site-logo mx-auto mb-5 h-12 w-auto dark:brightness-0 dark:invert"
      src="/assets/images/logo.svg"
      alt={footer.logoAlt}
      width="256"
      height="48"
    />
    <p
      class="m-0 font-serif text-[clamp(2.75rem,8vw,4.25rem)] font-light tracking-[0.12em] text-brand-lavender/80 dark:text-brand-sage-bright/70"
      aria-hidden="true"
    >
      {notFound.statusMark}
    </p>
    <h1 class="m-0 mt-2 font-serif text-[clamp(1.85rem,4vw,2.6rem)] font-light tracking-wide text-balance">
      {notFound.title}
    </h1>
    <p class="mx-auto mt-5 mb-0 max-w-[36ch] text-[1.05rem] leading-relaxed text-brand-muted text-pretty">
      {notFound.message}
    </p>

    <div class="mt-9 flex flex-col items-stretch gap-3 sm:flex-row sm:justify-center">
      <a class="btn-brand inline-flex min-h-12 items-center justify-center no-underline" href={massagesHref}>
        {notFound.massagesLabel}
      </a>
      <a
        class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full border border-glass-edge bg-glass-control px-5 text-inherit no-underline shadow-glass backdrop-blur-glass-control transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-sage dark:shadow-[var(--shadow-glass-dark)]"
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        data-whatsapp-direct
      >
        <i class="fa-brands fa-whatsapp text-[1.15rem]" aria-hidden="true"></i>
        {notFound.whatsappLabel}
      </a>
    </div>
  </article>
</main>
