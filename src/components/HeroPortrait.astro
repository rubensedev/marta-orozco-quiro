---
interface Props {
  class?: string;
  priority?: boolean;
  portraitAlt: string;
}

const {
  class: className = "",
  priority = false,
  portraitAlt,
} = Astro.props;
---

<div class:list={["hero-portrait", className]}>
  <img
    class="hero-portrait__image"
    src="/assets/images/hero-marta.svg"
    alt={portraitAlt}
    width="260"
    height="514"
    loading={priority ? "eager" : "lazy"}
    fetchpriority={priority ? "high" : "auto"}
    decoding="async"
  />
</div>
