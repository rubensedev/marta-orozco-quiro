---
import type { SiteBundle } from "../data/site";

type Props = {
  site: SiteBundle;
};

const { site } = Astro.props;
const { meta, ui } = site;
---

<aside
  class="w-full fixed right-0 bottom-0 z-30 flex items-center justify-between gap-4 border-t border-glass-edge bg-glass-chrome/92 px-4 py-2 shadow-glass backdrop-blur-glass-chrome lg:hidden dark:shadow-[var(--shadow-glass-dark)]"
>
  <a
    class="flex min-w-0 flex-col"
    href={`https://wa.me/${meta.whatsappNumber}?text=${encodeURIComponent(meta.whatsappInquiry)}`}
    data-whatsapp-direct
  >
    <span class="m-0 text-[0.9rem] text-brand-muted">{ui.reserveAppointment}</span>
    <span class="text-[0.9rem] font-semibold">{meta.whatsappDisplay}</span>
  </a>

  <button class="btn-brand" type="button" data-open-booking>
    {ui.reserveNow}
    <i class="fa-solid fa-chevron-right text-[10px]"></i>
  </button>
</aside>
