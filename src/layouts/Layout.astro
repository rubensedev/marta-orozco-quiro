---
import "@fontsource/noto-sans/latin-300.css";
import "@fontsource/noto-sans/latin-400.css";
import "@fontsource/noto-sans/latin-500.css";
import "@fontsource/noto-sans/latin-600.css";
import "@fontsource/noto-serif/latin-300.css";
import "@fontsource/noto-serif/latin-400.css";
import "@fontsource/noto-serif/latin-500.css";
import "@fontsource/noto-serif/latin-600.css";
import notoSans400Woff2 from "@fontsource/noto-sans/files/noto-sans-latin-400-normal.woff2?url";
import notoSerif400Woff2 from "@fontsource/noto-serif/files/noto-serif-latin-400-normal.woff2?url";
import "../styles/global.css";
import SeoJsonLd from "../components/SeoJsonLd.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import type { SiteBundle } from "../data/site";

type Props = {
  site: SiteBundle;
};

const { site } = Astro.props;
const { meta, locale } = site;

const siteOrigin = Astro.site ?? new URL("https://martaorozcoquiro.netlify.app");
const canonicalPath = getRelativeLocaleUrl(locale);
const canonicalUrl = new URL(canonicalPath, siteOrigin).href;
const esUrl = new URL(getRelativeLocaleUrl("es"), siteOrigin).href;
const enUrl = new URL(getRelativeLocaleUrl("en"), siteOrigin).href;
const ogImageUrl = new URL(meta.ogImage, siteOrigin).href;
---

<!doctype html>
<html
  lang={meta.lang}
  data-locale={locale}
  class="scroll-smooth scheme-light dark:scheme-dark"
>
  <head>
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={meta.description} />
    <meta name="robots" content="index, follow" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={meta.themeColor} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Marta Orozco" />
    <meta property="og:locale" content={meta.ogLocale} />
    <meta property="og:locale:alternate" content={meta.ogLocaleAlternate} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(meta.ogImageWidth)} />
    <meta property="og:image:height" content={String(meta.ogImageHeight)} />
    <meta property="og:image:alt" content={meta.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={notoSans400Woff2}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={notoSerif400Woff2}
      crossorigin
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <SeoJsonLd site={site} />
    <script is:inline>
      (function () {
        var saved = localStorage.getItem("marta-orozco-theme");
        var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        var useDark =
          saved === "dark" || (saved !== "light" && (saved === "system" || !saved) && prefersDark);
        if (useDark) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
    <script is:inline>
      (function () {
        try {
          var LOCALE_KEY = "marta-orozco-locale";
          var ua = (navigator.userAgent || "").toLowerCase();
          if (
            /bot|crawl|spider|slurp|facebookexternalhit|preview|lighthouse|pagespeed|pingdom|yandex|baidu|duckduck|semrush|ahrefs|bytespider/i.test(
              ua,
            )
          ) {
            return;
          }

          var pageLocale = document.documentElement.getAttribute("data-locale") || "es";
          var stored = localStorage.getItem(LOCALE_KEY);
          var preferred = stored === "es" || stored === "en" ? stored : null;

          if (!preferred) {
            var langs =
              navigator.languages && navigator.languages.length
                ? navigator.languages
                : [navigator.language || "en"];
            var spainRelated = false;
            for (var i = 0; i < langs.length; i++) {
              var code = String(langs[i] || "").toLowerCase();
              var primary = code.split("-")[0];
              if (
                primary === "es" ||
                primary === "ca" ||
                primary === "gl" ||
                primary === "eu" ||
                code.indexOf("es-") === 0
              ) {
                spainRelated = true;
                break;
              }
            }
            preferred = spainRelated ? "es" : "en";
          }

          if (preferred === pageLocale) return;

          var hash = window.location.hash || "";
          var esToEn = {
            inicio: "home",
            "sobre-mi": "about",
            masajes: "massages",
            bonos: "packages",
            "preguntas-frecuentes": "faq",
            testimonios: "testimonials",
            contacto: "contact",
          };
          var enToEs = {
            home: "inicio",
            about: "sobre-mi",
            massages: "masajes",
            packages: "bonos",
            faq: "preguntas-frecuentes",
            testimonials: "testimonios",
            contact: "contacto",
          };
          var raw = hash.replace(/^#/, "");
          var mapped = "";
          if (raw) {
            mapped =
              preferred === "en"
                ? esToEn[raw] || (enToEs[raw] ? raw : raw)
                : enToEs[raw] || (esToEn[raw] ? raw : raw);
          }
          var nextHash = mapped ? "#" + mapped : hash;
          var nextPath = preferred === "en" ? "/en/" : "/";
          window.location.replace(nextPath + nextHash);
        } catch (e) {
          /* ignore boot failures */
        }
      })();
    </script>
    <title>{meta.title}</title>
  </head>
  <body
    class="m-0 min-w-[320px] pb-20 font-sans text-brand-text-dark transition-colors duration-300 ease-in-out lg:pb-0 dark:text-brand-text-light"
  >
    <slot />
  </body>
</html>
